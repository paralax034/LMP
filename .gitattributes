# Нормализация концов строк: в индексе текст всегда хранится с LF,
# в рабочем дереве Windows получает CRLF (core.eol=native).
* text=auto

# bash не переносит \r: скрипты оболочки только с LF в любой ОС.
*.sh    text eol=lf

# cmd.exe ненадёжно обрабатывает метки и goto в файлах с LF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

