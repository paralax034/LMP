<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TYPOGRAPHY                                                          -->
    <!-- Global text styles for headings, labels, descriptions.             -->
    <!-- Source: SettingsView local styles → extracted for reuse            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Section header -->
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,32,0,12" />
    </Style>

    <!-- Setting / field label -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Description / hint -->
    <Style Selector="TextBlock.desc">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Monospaced value (sliders, numeric fields) -->
    <Style Selector="TextBlock.value-label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Consolas, monospace" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="60" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- CARDS                                                               -->
    <!-- Background container for grouping settings/content.                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BoxShadow" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- COLOR ROW                                                           -->
    <!-- Color picker row in theme settings.                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="Grid.color-row">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="Grid.color-row TextBlock.color-name">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Grid.color-row TextBlock.color-hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FEATURE BADGES (BOOST, BETA, SOON)                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style Selector="Border.feature-badge">
        <Setter Property="Background" Value="{DynamicResource AccentTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Border.feature-badge TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.feature-badge.coming-soon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemInfoBlueBrush}" />
    </Style>
    <Style Selector="Border.feature-badge.coming-soon TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemInfoBlueBrush}" />
    </Style>
    <Style Selector="Border.feature-badge.experimental">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemWarnOrangeBrush}" />
    </Style>
    <Style Selector="Border.feature-badge.experimental TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemWarnOrangeBrush}" />
    </Style>

</Styles>