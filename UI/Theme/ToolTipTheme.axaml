<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
         GLOBAL TOOLTIP THEME
         Использует динамические ресурсы темы
    -->

    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border x:Name="PART_LayoutRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6"
                    BoxShadow="{StaticResource CardShadow}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        TextWrapping="Wrap"
                        MaxWidth="{TemplateBinding MaxWidth}">
                        <ContentPresenter.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Style>
                        </ContentPresenter.Styles>
                    </ContentPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- COMPACT VARIANT -->
    <Style Selector="ToolTip.compact">
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BgHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    BoxShadow="{StaticResource CardShadow}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        TextWrapping="Wrap">
                        <ContentPresenter.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Style>
                        </ContentPresenter.Styles>
                    </ContentPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ACCENT VARIANT -->
    <Style Selector="ToolTip.accent">
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6"
                    BoxShadow="{StaticResource CardShadow}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        TextWrapping="Wrap">
                        <ContentPresenter.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </ContentPresenter.Styles>
                    </ContentPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- INFO VARIANT (с акцентной нижней полосой) -->
    <Style Selector="ToolTip.info">
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BgHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    BoxShadow="{StaticResource CardShadow}">
                    <Grid RowDefinitions="*, Auto">
                        <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextWrapping="Wrap">
                            <ContentPresenter.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </ContentPresenter.Styles>
                        </ContentPresenter>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource AccentBrush}"
                            Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>