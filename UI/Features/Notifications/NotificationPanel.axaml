<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notifications="using:LMP.UI.Features.Notifications"
    xmlns:models="using:LMP.Core.Models"
    xmlns:ctrl="using:LMP.UI.Controls"
    x:Class="LMP.UI.Features.Notifications.NotificationPanel"
    x:DataType="notifications:NotificationPanelViewModel"
    x:Name="RootPanel">

    <UserControl.Styles>
        <!-- Notification item: flat chronicle without animation allocations during scroll recycling -->
        <Style Selector="Border.notification-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.notification-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
        </Style>

        <!-- Soft severity badge with sufficient size and contrast -->
        <Style Selector="Border.severity-badge">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,12,0" />
            <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Outline highlight for the active filter button in the notification header -->
        <Style Selector="Button.header-icon-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentTransparentBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Compact outline action button inside the task (Send Now / Cancel) -->
        <Style Selector="Button.task-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.task-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Recommendation block: subtle accent stroke on the left without heavy borders -->
        <Style Selector="Border.recommendation-quote">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Track metadata -->
        <Style Selector="Grid.track-info-strip">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Technical stack trace container -->
        <Style Selector="Border.code-log-box">
            <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightTransparentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Native Expander styling for clean inline display -->
        <Style Selector="Expander.clean-expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Expander header: remove system borders and paddings -->
        <Style Selector="Expander.clean-expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Override inner Border#ToggleButtonBackground background in all states,
        excluding the dark rectangle -->
        <Style
            Selector="Expander.clean-expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground,
                     Expander.clean-expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground,
                     Expander.clean-expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground,
                     Expander.clean-expander /template/ ToggleButton#ExpanderHeader:checked /template/ Border#ToggleButtonBackground,
                     Expander.clean-expander /template/ ToggleButton#ExpanderHeader:checked:pointerover /template/ Border#ToggleButtonBackground,
                     Expander.clean-expander /template/ ToggleButton#ExpanderHeader:checked:pressed /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Hide the second redundant right gray chevron of the Fluent template -->
        <Style
            Selector="Expander.clean-expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style
            Selector="Expander.clean-expander /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Rotate the single left accent chevron when expanded -->
        <Style Selector="Expander.clean-expander:expanded PathIcon.expand-chevron">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="180" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- Docking container: SHARP TOP (0,0), ROUNDED BOTTOM (8,8), NO TOP BORDER
    (1,0,1,1) -->
    <Border Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BgHighlightBrush}"
        BorderThickness="1,0,1,1"
        CornerRadius="0,0,8,8"
        Width="380"
        MaxHeight="500"
        BoxShadow="{StaticResource CardShadow}"
        ClipToBounds="True">

        <Grid RowDefinitions="Auto, *">

            <!-- Compact utility bar: filter icons (All / Notifications / Tasks), forced dispatch, and clear -->
            <Grid Grid.Row="0"
                ColumnDefinitions="Auto, *, Auto, Auto"
                Margin="10,6,10,6">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="header-icon-btn"
                        Classes.active="{Binding IsFilterAll}"
                        Command="{Binding SetFilterAllCommand}"
                        ToolTip.Tip="{Binding L[Notification_Filter_All]}"
                        Width="26" Height="26" Padding="4">
                        <PathIcon Data="{StaticResource Icon.BellOutline}" Width="13" Height="13" />
                    </Button>

                    <Button Classes="header-icon-btn"
                        Classes.active="{Binding IsFilterNotifications}"
                        Command="{Binding SetFilterNotificationsCommand}"
                        ToolTip.Tip="{Binding L[Notification_Filter_Notifications]}"
                        Width="26" Height="26" Padding="4">
                        <PathIcon Data="{StaticResource Icon.InformationOutline}" Width="13" Height="13" />
                    </Button>

                    <Button Classes="header-icon-btn"
                        Classes.active="{Binding IsFilterTasks}"
                        Command="{Binding SetFilterTasksCommand}"
                        ToolTip.Tip="{Binding L[Notification_Filter_Tasks]}"
                        Width="26" Height="26" Padding="4">
                        <PathIcon Data="{StaticResource Icon.CloudSync}" Width="14" Height="14" />
                    </Button>

                    <TextBlock Text="{Binding DisplayedNotifications.Count, StringFormat='{}{0}'}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                    Classes="header-icon-btn"
                    Command="{Binding ForceFlushAllCommand}"
                    IsVisible="{Binding HasActiveTasks}"
                    ToolTip.Tip="{Binding L[CloudTask_ForceAll]}"
                    Width="26" Height="26"
                    Padding="3"
                    Margin="0,0,2,0"
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.CloudUpload}"
                        Foreground="{DynamicResource AccentBrush}"
                        Width="14" Height="14" />
                </Button>

                <Button Grid.Column="3"
                    Classes="header-icon-btn"
                    Command="{Binding ClearAllCommand}"
                    IsVisible="{Binding HasNotifications}"
                    ToolTip.Tip="{Binding L[Notification_Clear]}"
                    Width="26" Height="26"
                    Padding="3"
                    VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.NotificationClearAll}"
                        Width="13" Height="13" />
                </Button>
            </Grid>

            <!-- Thin divider below the utility header -->
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                Background="{DynamicResource BgHighlightTransparentBrush}" />

            <!-- ═══ HIGH-PERFORMANCE NOTIFICATION LIST ═══ -->
            <Grid Grid.Row="1">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !HasNotifications}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Margin="0,48">
                    <PathIcon Data="{StaticResource Icon.BellSleep}"
                        Width="28" Height="28"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Opacity="0.4" />
                    <TextBlock Text="{Binding L[Notification_NoNotifications]}"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                        Opacity="0.7" />
                </StackPanel>

                <!--
                    ListBox with hardware pixel virtualization:
                    ScrollViewer.IsScrollInertiaEnabled="True" guarantees smooth 60/120 FPS scrolling.
                    Focusable="False" disables idle focus search passes.
                    MaxHeight="450" guarantees restricting the scroll area inside the Popup.
                -->
                <ListBox IsVisible="{Binding HasNotifications}"
                    ItemsSource="{Binding DisplayedNotifications}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Focusable="False"
                    MaxHeight="450"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.IsScrollInertiaEnabled="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style
                            Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style
                            Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Notification}">
                            <Border Classes="notification-row">
                                <Grid ColumnDefinitions="Auto, *">

                                    <!-- Concise round severity indicator with color-coded
                                    badge highlight -->
                                    <Border Grid.Column="0" Classes="severity-badge">
                                        <TextBlock Text="{Binding Icon}"
                                            Foreground="{Binding SeverityColorHex}"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Information content -->
                                    <StackPanel Grid.Column="1" Spacing="2">

                                        <!-- Title and relative time on a single line -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0"
                                                Text="{Binding Title}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                Text="{Binding TimeAgo}"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Opacity="0.75" />
                                        </Grid>

                                        <!-- Message text -->
                                        <TextBlock Text="{Binding Message}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            LineHeight="16"
                                            Margin="0,1,0,0" />

                                        <!-- Progress bar (only for tasks with actual progress) and quick action button (Send Now / Cancel) -->
                                        <StackPanel Spacing="6"
                                            Margin="0,5,0,2"
                                            IsVisible="{Binding ShowTaskFooter}">
                                            <ProgressBar Minimum="0" Maximum="1"
                                                IsVisible="{Binding ShowTaskProgress}"
                                                Value="{Binding TaskProgress}"
                                                IsIndeterminate="{Binding IsTaskIndeterminate}"
                                                Height="3"
                                                CornerRadius="1.5" />

                                            <Button Classes="task-action-btn"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding HasTaskAction}"
                                                Command="{Binding TaskActionCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource Icon.CloudUpload}"
                                                        IsVisible="{Binding !IsCancelAction}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                    <PathIcon Data="{StaticResource Icon.Close}"
                                                        IsVisible="{Binding IsCancelAction}"
                                                        Width="10" Height="10"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TaskActionText}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Track context with original CopyLinkButton -->
                                        <Grid Classes="track-info-strip"
                                            ColumnDefinitions="Auto, *, Auto"
                                            IsVisible="{Binding TrackTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <PathIcon Grid.Column="0"
                                                Data="{StaticResource Icon.MusicNote}"
                                                Width="12" Height="12"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                Text="{Binding TrackTitle}"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <ctrl:CopyLinkButton Grid.Column="2"
                                                CopyUrl="{Binding TrackUrl}"
                                                ButtonSize="22"
                                                IconSize="12"
                                                ToolTipText="{Binding L[Notification_CopyTrackUrl]}"
                                                SuccessText="{Binding L[Common_Copied]}"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0"
                                                IsVisible="{Binding TrackUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Grid>

                                        <!-- Recommendation: minimalist quote with stroke -->
                                        <Border Classes="recommendation-quote"
                                            IsVisible="{Binding HasRecommendation}">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <PathIcon Grid.Column="0"
                                                    Data="{StaticResource Icon.Lightbulb}"
                                                    Width="14" Height="14"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                    Text="{Binding Recommendation}"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    TextWrapping="Wrap"
                                                    LineHeight="15"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Inline spoiler for technical details -->
                                        <Expander Classes="clean-expander"
                                            IsVisible="{Binding HasDetails}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                                    <PathIcon Classes="expand-chevron"
                                                        Data="{StaticResource Icon.ChevronDown}"
                                                        Width="10" Height="10"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center">
                                                        <PathIcon.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition
                                                                    Property="RenderTransform"
                                                                    Duration="0:0:0.15" />
                                                            </Transitions>
                                                        </PathIcon.Transitions>
                                                    </PathIcon>
                                                    <TextBlock
                                                        Text="{Binding L[Notification_ViewDetails]}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand" />
                                                </StackPanel>
                                            </Expander.Header>

                                            <StackPanel Spacing="4" Margin="0,4,0,0">

                                                <!-- Client attempts list -->
                                                <ItemsControl ItemsSource="{Binding Attempts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate
                                                            DataType="{x:Type models:AttemptRecord}">
                                                            <Grid ColumnDefinitions="Auto, Auto, *"
                                                                Margin="0,1">
                                                                <TextBlock Grid.Column="0"
                                                                    Text="{Binding StatusIcon}"
                                                                    FontSize="11"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                    Text="{Binding ClientName}"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2"
                                                                    Text="{Binding DisplayMessage}"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Exception trace -->
                                                <Border Classes="code-log-box"
                                                    IsVisible="{Binding HasExceptionDetails}">
                                                    <ScrollViewer MaxHeight="100"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding ExceptionDetails}"
                                                            FontSize="10"
                                                            FontFamily="Consolas, monospace"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            TextWrapping="Wrap"
                                                            LineHeight="14" />
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- Copy error with visual feedback -->
                                                <Button Classes="ghost-btn"
                                                    Height="24"
                                                    Padding="6,2"
                                                    IsVisible="{Binding HasExceptionDetails}"
                                                    Tag="{Binding ExceptionDetails}"
                                                    Click="OnCopyErrorClick"
                                                    ToolTip.Tip="{Binding L[Notification_CopyError]}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,3,0,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                        <PathIcon
                                                            Data="{StaticResource Icon.ContentCopy}"
                                                            Width="12" Height="12"
                                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock
                                                            Text="{Binding L[Notification_CopyError]}"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                            </StackPanel>
                                        </Expander>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Grid>
    </Border>
</UserControl>
