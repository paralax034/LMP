<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notifications="using:LMP.UI.Features.Notifications"
    x:Class="LMP.UI.Features.Notifications.ToastOverlay"
    x:DataType="notifications:ToastOverlayViewModel"
    IsHitTestVisible="{Binding IsVisible}">

    <Panel>
        <Border IsVisible="{Binding IsVisible}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BgHighlightBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            MinWidth="280"
            MaxWidth="390"
            BoxShadow="{StaticResource CardShadow}"
            ClipToBounds="True">

            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"
                        Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Лаконичный круглый индикатор серьезности в едином стиле с NotificationPanel -->
                <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Margin="0,1,12,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource BgElevatedTransparentBrush}"
                    BorderBrush="{DynamicResource BgHighlightBrush}"
                    BorderThickness="1">
                    <TextBlock Text="{Binding ToastIcon}"
                        Foreground="{Binding ToastSeverityColorHex}"
                        FontSize="13"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <!-- Информационное содержимое -->
                <StackPanel Grid.Column="1"
                    Spacing="2"
                    VerticalAlignment="Center"
                    MinWidth="0">
                    <TextBlock Text="{Binding ToastTitle}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        LineHeight="17" />
                    <TextBlock Text="{Binding ToastMessage}"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        TextWrapping="Wrap"
                        LineHeight="16" />
                </StackPanel>

                <!-- Кнопка закрытия тоста -->
                <Button Grid.Column="2"
                    Classes="header-icon-btn"
                    Width="24" Height="24"
                    Padding="4"
                    Command="{Binding DismissCommand}"
                    VerticalAlignment="Top"
                    Margin="6,0,0,0">
                    <PathIcon Data="{StaticResource Icon.Close}"
                        Width="11" Height="11" />
                </Button>
            </Grid>
        </Border>
    </Panel>
</UserControl>