<UserControl
    x:Class="LMP.UI.Features.Player.PlayerBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Player"
    xmlns:controls="using:LMP.UI.Controls"
    x:DataType="vm:PlayerBarViewModel"
    Padding="0"
    ClipToBounds="False"
    Focusable="True"
    UseLayoutRounding="True">

    <Border Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BgHighlightBrush}"
        BorderThickness="0,1,0,0"
        UseLayoutRounding="True"
        ClipToBounds="False">
        <Grid RowDefinitions="Auto,*">

            <Grid
                Name="SeekContainer"
                Grid.Row="0"
                Height="10"
                VerticalAlignment="Top"
                Background="Transparent"
                Classes="seek-container"
                Classes.is-loading="{Binding IsLoading}"
                ClipToBounds="False"
                Cursor="Hand">

                <Grid
                    Name="TrackContainer"
                    Height="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Classes="track-container"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.0">

                    <!-- Высокопроизводительный кастомный векторный прогресс-бар -->
                    <controls:BufferedProgressBar
                        Name="CustomProgressBar"
                        Maximum="{Binding DurationSeconds}"
                        BufferedRanges="{Binding BufferedRanges}"
                        IsFullyBuffered="{Binding IsFullyBuffered}"
                        ForegroundBrush="{DynamicResource AccentBrush}"
                        BackgroundBrush="{DynamicResource BgHighlightBrush}"
                        BufferBrush="{DynamicResource TextSecondaryBrush}" />

                    <!-- Единая сквозная искра по всему таймлайну при загрузке -->
                    <Border Name="SparkContainer"
                        ClipToBounds="True"
                        CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Height="4"
                        IsHitTestVisible="False"
                        IsVisible="{Binding IsLoading}">
                        <Border Name="SparkRunner"
                            Width="120" Height="4"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="-120" />
                            </Border.RenderTransform>
                            <Border.Styles>
                                <Style
                                    Selector="Border#SparkContainer[IsVisible=True] > Border#SparkRunner">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1.8"
                                            IterationCount="Infinite"
                                            Easing="CubicEaseInOut">
                                            <!-- Фаза 1: Быстрый старт -->
                                            <KeyFrame Cue="0%">
                                                <Setter Property="TranslateTransform.X" Value="-120" />
                                            </KeyFrame>
                                            <!-- Фаза 2: Замедление/дрейф в центре -->
                                            <KeyFrame Cue="30%">
                                                <Setter Property="TranslateTransform.X" Value="320" />
                                            </KeyFrame>
                                            <KeyFrame Cue="60%">
                                                <Setter Property="TranslateTransform.X" Value="620" />
                                            </KeyFrame>
                                            <!-- Фаза 3: Взрывное ускорение -->
                                            <KeyFrame Cue="85%">
                                                <Setter Property="TranslateTransform.X" Value="1820" />
                                            </KeyFrame>
                                            <!-- Фаза 4: Финишный уход за экран -->
                                            <KeyFrame Cue="100%">
                                                <Setter Property="TranslateTransform.X" Value="2400" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="0.5" Color="{DynamicResource Accent}" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </Grid>

                <!-- Курсор предпросмотра (призрачный, следует за мышью) -->
                <Canvas
                    Name="PreviewCursorCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    ClipToBounds="False">
                    <Border
                        Name="SeekPreviewCursor"
                        Canvas.Top="-3"
                        Width="3"
                        Height="14"
                        Background="{DynamicResource AccentBrush}"
                        Classes="seek-preview-cursor"
                        CornerRadius="1.5"
                        IsHitTestVisible="False" />
                </Canvas>

                <!-- Бегунок и основной курсор + Рельсы перемотки -->
                <Canvas
                    Name="ThumbCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    ClipToBounds="False"
                    IsHitTestVisible="False">

                    <!-- Высокопроизводительный полый мост-рельсы -->
                    <Grid
                        Name="SeekRangeSpan"
                        Canvas.Top="-1.5"
                        Height="11"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            </Transitions>
                        </Grid.Transitions>

                        <!-- Верхняя рельса -->
                        <Border
                            Height="1.5"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}" />

                        <!-- Нижняя рельса -->
                        <Border
                            Height="1.5"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}" />
                    </Grid>

                    <Border
                        Name="SeekCursor"
                        Canvas.Left="0"
                        Canvas.Top="-1"
                        Width="2"
                        Height="12"
                        Background="{DynamicResource AccentBrush}"
                        Classes="seek-cursor"
                        CornerRadius="1">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                    </Border>

                    <!-- ПРЯМОУГОЛЬНЫЙ БЕГУНОК -->
                    <Border
                        Name="SeekThumb"
                        Canvas.Left="0"
                        Canvas.Top="-3"
                        Width="3"
                        Height="14"
                        Classes="slider-thumb"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="1.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                    </Border>
                </Canvas>

                <!-- ВЫСОКОПРОИЗВОДИТЕЛЬНЫЕ ВЕКТОРНЫЕ ОВЕРЛЕИ -->
                <Canvas
                    Name="OverlayCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ClipToBounds="False"
                    IsHitTestVisible="False">

                    <!-- ТУЛТИП ЦЕЛЕВОГО ВРЕМЕНИ -->
                    <Border
                        Name="SeekTooltip"
                        Padding="8,4"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Canvas.Top="-36"
                        Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <TextBlock
                            Name="HoverTimeText"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="0:00" />
                    </Border>
                    <!-- Окно подсказки отмены Seek -->
                    <Border
                        Name="SeekHint"
                        Padding="8,4"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BgHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Canvas.Top="-64"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14"
                                Foreground="{DynamicResource AccentBrush}"
                                Data="{StaticResource Icon.InformationOutline}" />
                            <TextBlock Name="SeekHintText" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Область обработки кликов -->
                <Border
                    Name="SeekHitBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    IsHitTestVisible="{Binding HasTrack}"
                    PointerCaptureLost="OnSeekAreaCaptureLost"
                    PointerExited="OnSeekAreaExited"
                    PointerMoved="OnSeekAreaMoved"
                    PointerPressed="OnSeekAreaPressed"
                    PointerReleased="OnSeekAreaReleased" />
            </Grid>

            <!-- КНОПКИ УПРАВЛЕНИЯ -->
            <Grid Grid.Row="1" Margin="8,4,8,4" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal"
                    Spacing="2">
                    <Button x:Name="ShuffleButton" Width="40" Height="40" Classes="playback-btn"
                        Classes.active="{Binding IsShuffleAnimating}"
                        Classes.auto-enabled="{Binding AutoShuffleEnabled}"
                        Command="{Binding ShuffleQueueCommand}" CornerRadius="20"
                        PointerEntered="OnShuffleButtonEntered"
                        PointerExited="OnShuffleButtonExited"
                        PointerPressed="OnShuffleButtonPressed">
                        <Panel Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                            <Panel Width="18" Height="18" IsVisible="{Binding !AutoShuffleEnabled}">
                                <PathIcon Width="18" Height="18"
                                    Data="{StaticResource Icon.Shuffle}" />
                            </Panel>
                            <Panel Width="18" Height="18" IsVisible="{Binding AutoShuffleEnabled}">
                                <PathIcon Width="18" Height="18"
                                    Data="{StaticResource Icon.ShuffleAuto}" />
                            </Panel>
                        </Panel>
                    </Button>
                    <Popup x:Name="ShufflePopup" ShouldUseOverlayLayer="True"
                        IsLightDismissEnabled="False" Placement="Top"
                        PlacementTarget="{Binding #ShuffleButton}" Topmost="True"
                        VerticalOffset="-8">
                        <Border Padding="10,7" Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BgHighlightBrush}" BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="3" MinWidth="160">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                                    <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Data="{StaticResource Icon.ShuffleAuto}"
                                        IsVisible="{Binding AutoShuffleEnabled}" />
                                    <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Data="{StaticResource Icon.Shuffle}"
                                        IsVisible="{Binding !AutoShuffleEnabled}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding ShuffleTooltip}" />
                                </StackPanel>
                                <TextBlock FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding L[Player_Shuffle_Hint]}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Width="40" Height="40" Classes="playback-btn"
                        Command="{Binding PreviousCommand}" CornerRadius="20"
                        ToolTip.Tip="{Binding PreviousTooltip}" ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6">
                        <PathIcon Width="20" Height="20" Data="{StaticResource Icon.SkipPrevious}" />
                    </Button>
                    <Button Width="52" Height="52" Classes="playback-btn-main"
                        Command="{Binding PlayPauseCommand}" CornerRadius="26"
                        ToolTip.Tip="{Binding PlayPauseTooltip}" ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6">
                        <Panel>
                            <PathIcon Width="26" Height="26" Data="{StaticResource Icon.Pause}"
                                IsVisible="{Binding IsPlaying}" />
                            <PathIcon Width="26" Height="26" Data="{StaticResource Icon.Play}"
                                IsVisible="{Binding !IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button Width="40" Height="40" Classes="playback-btn"
                        Command="{Binding NextCommand}" CornerRadius="20"
                        ToolTip.Tip="{Binding NextTooltip}" ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6">
                        <PathIcon Width="20" Height="20" Data="{StaticResource Icon.SkipNext}" />
                    </Button>
                    <Button x:Name="RepeatButton" Width="40" Height="40" Classes="playback-btn"
                        Classes.active="{Binding !IsRepeatNone}"
                        Command="{Binding ToggleRepeatCommand}" CornerRadius="20"
                        ToolTip.Tip="{Binding RepeatTooltip}" ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6">
                        <Grid>
                            <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Repeat}"
                                IsVisible="{Binding IsRepeatNone}" />
                            <PathIcon Width="18" Height="18" Data="{StaticResource Icon.RepeatOnce}"
                                IsVisible="{Binding IsRepeatOne}" />
                            <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Repeat}"
                                IsVisible="{Binding IsRepeatAll}" />
                        </Grid>
                    </Button>
                    <Popup ShouldUseOverlayLayer="True" HorizontalOffset="0"
                        IsLightDismissEnabled="False"
                        IsOpen="{Binding IsRepeatHintVisible}" Placement="Top"
                        PlacementTarget="{Binding #RepeatButton}" Topmost="True" VerticalOffset="-8">
                        <Border Classes="mode-hint" Classes.visible="{Binding IsRepeatHintVisible}"
                            Padding="10,7" Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BgHighlightBrush}" BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                                <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Data="{StaticResource Icon.Repeat}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding RepeatHintText}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Border Width="1" Height="28" Margin="6,0"
                        Background="{DynamicResource BgHighlightBrush}" />
                    <controls:VolumeControl Volume="{Binding Volume}"
                        MaxVolume="{Binding MaxVolume}" />
                    <Button x:Name="EqualizerButton" Width="38" Height="38" Classes="playback-btn"
                        CornerRadius="19"
                        ToolTip.Tip="{Binding L[Eq_Title]}" ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6">
                        <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Equalizer}" />
                        <Button.Flyout>
                            <Flyout Placement="Top" VerticalOffset="-24"
                                Opened="OnEqualizerFlyoutOpened"
                                Closed="OnEqualizerFlyoutClosed">
                                <StackPanel Width="364" Margin="4,4,4,0" Spacing="4">
                                    <!-- Единая строка: Питание | Режимы трека | Пресеты, 5/10,
                                    Сброс -->
                                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto"
                                        VerticalAlignment="Center">
                                        <!-- Блок 1: Питание -->
                                        <ToggleSwitch Grid.Column="0"
                                            IsChecked="{Binding IsEqualizerEnabled}"
                                            ToolTip.Tip="{Binding L[Eq_Title]}"
                                            ToolTip.Placement="Top"
                                            ToolTip.VerticalOffset="-6"
                                            VerticalAlignment="Center" Margin="0,0,4,0" />

                                        <!-- Блок 2: Режимы привязки (Нота vs Глобус) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Spacing="4" VerticalAlignment="Center">
                                            <Border Width="1" Height="16"
                                                Background="{DynamicResource BgHighlightBrush}"
                                                Margin="2,0" />

                                            <!-- Для текущего трека (Нота) -->
                                            <Button Width="28" Height="28" CornerRadius="6"
                                                Classes="icon-btn"
                                                IsEnabled="{Binding HasTrack}"
                                                Command="{Binding ToggleTrackEqualizerModeCommand}"
                                                Click="OnEqHeaderButtonClicked"
                                                ToolTip.Tip="{Binding TrackEqualizerTooltip}"
                                                ToolTip.Placement="Top"
                                                ToolTip.VerticalOffset="-6"
                                                ToolTip.ShowDelay="50">
                                                <Panel>
                                                    <PathIcon Width="14" Height="14"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Data="{StaticResource Icon.MusicNote}"
                                                        IsVisible="{Binding !IsTrackModeHighlighted}" />
                                                    <PathIcon Width="14" Height="14"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Data="{StaticResource Icon.MusicNote}"
                                                        IsVisible="{Binding IsTrackModeHighlighted}" />
                                                </Panel>
                                            </Button>

                                            <!-- Единый для всех (Глобус) -->
                                            <Button Width="28" Height="28" CornerRadius="6"
                                                Classes="icon-btn"
                                                Command="{Binding ToggleForceGlobalEqualizerCommand}"
                                                Click="OnEqHeaderButtonClicked"
                                                ToolTip.Tip="{Binding ForceGlobalEqualizerTooltip}"
                                                ToolTip.Placement="Top"
                                                ToolTip.VerticalOffset="-6"
                                                ToolTip.ShowDelay="50">
                                                <Panel>
                                                    <PathIcon Width="14" Height="14"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Data="{StaticResource Icon.Web}"
                                                        IsVisible="{Binding !ForceGlobalEqualizer}" />
                                                    <PathIcon Width="14" Height="14"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Data="{StaticResource Icon.Web}"
                                                        IsVisible="{Binding ForceGlobalEqualizer}" />
                                                </Panel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Блок 3: Выпадающее меню пресетов (только по наведению) -->
                                        <Panel Grid.Column="3" Margin="0,0,4,0"
                                            PointerEntered="OnPresetsTriggerPointerEntered"
                                            PointerExited="OnPresetsTriggerPointerExited">
                                            <Button x:Name="EqPresetsButton" Padding="9,4"
                                                CornerRadius="6" VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding L[Eq_Presets_Tooltip]}"
                                                ToolTip.Placement="Top"
                                                ToolTip.VerticalOffset="-6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                        Text="{Binding ActiveEqualizerPresetTitle}"
                                                        MaxWidth="105"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <PathIcon Width="10" Height="10"
                                                        Data="{StaticResource Icon.ChevronUp}"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Popup x:Name="EqPresetsPopup"
                                                Placement="TopEdgeAlignedRight"
                                                PlacementTarget="{Binding #EqPresetsButton}"
                                                VerticalOffset="0"
                                                IsLightDismissEnabled="False">
                                                <Border x:Name="EqPresetsPopupRoot"
                                                    Padding="0,0,0,6" Background="Transparent"
                                                    PointerEntered="OnPresetsPopupPointerEntered"
                                                    PointerExited="OnPresetsPopupPointerExited">
                                                    <Border Width="230" Padding="4"
                                                        Background="{DynamicResource BgPrimaryBrush}"
                                                        BorderBrush="{DynamicResource BgHighlightBrush}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        BoxShadow="{StaticResource CardShadow}">
                                                        <StackPanel Spacing="2">
                                                            <ScrollViewer MaxHeight="210"
                                                                HorizontalScrollBarVisibility="Disabled">
                                                                <ItemsControl
                                                                    ItemsSource="{Binding EqualizerPresetsList}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate
                                                                            x:DataType="vm:EqualizerPresetChipItem">
                                                                            <Panel>
                                                                                <!-- Обычная строка
                                                                                пресета (в стиле
                                                                                подменю плейлистов) -->
                                                                                <Button
                                                                                    HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Stretch"
                                                                                    Padding="10,7"
                                                                                    Margin="0,1"
                                                                                    Classes="format-item-btn"
                                                                                    Classes.active="{Binding IsSelected}"
                                                                                    IsVisible="{Binding !IsRenaming}"
                                                                                    ToolTip.Tip="{Binding RightClickHint}"
                                                                                    ToolTip.Placement="Top"
                                                                                    ToolTip.VerticalOffset="-4"
                                                                                    PointerReleased="OnPresetItemPointerReleased"
                                                                                    Command="{Binding $parent[UserControl].((vm:PlayerBarViewModel)DataContext).SelectEqualizerPresetCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                    <Grid
                                                                                        ColumnDefinitions="22,*">
                                                                                        <PathIcon
                                                                                            Grid.Column="0"
                                                                                            Width="14"
                                                                                            Height="14"
                                                                                            Data="{StaticResource Icon.Check}"
                                                                                            Foreground="{DynamicResource AccentBrush}"
                                                                                            IsVisible="{Binding IsSelected}"
                                                                                            HorizontalAlignment="Left"
                                                                                            VerticalAlignment="Center" />
                                                                                        <TextBlock
                                                                                            Grid.Column="1"
                                                                                            FontSize="12"
                                                                                            Text="{Binding Title}"
                                                                                            TextTrimming="CharacterEllipsis"
                                                                                            VerticalAlignment="Center" />
                                                                                    </Grid>
                                                                                </Button>

                                                                                <!-- Режим
                                                                                переименования
                                                                                активного пресета
                                                                                прямо в списке -->
                                                                                <Grid
                                                                                    ColumnDefinitions="*,Auto"
                                                                                    ColumnSpacing="4"
                                                                                    Margin="0,1"
                                                                                    IsVisible="{Binding IsRenaming}">
                                                                                    <TextBox
                                                                                        Grid.Column="0"
                                                                                        Text="{Binding EditTitle}"
                                                                                        FontSize="12"
                                                                                        Padding="8,5"
                                                                                        KeyDown="OnRenamePresetTextBoxKeyDown"
                                                                                        LostFocus="OnRenamePresetTextBoxLostFocus" />
                                                                                    <Button
                                                                                        Grid.Column="1"
                                                                                        Width="28"
                                                                                        Height="28"
                                                                                        Classes="icon-btn active"
                                                                                        Command="{Binding $parent[UserControl].((vm:PlayerBarViewModel)DataContext).CommitRenamePresetCommand}"
                                                                                        CommandParameter="{Binding}">
                                                                                        <PathIcon
                                                                                            Width="12"
                                                                                            Height="12"
                                                                                            Data="{StaticResource Icon.Check}" />
                                                                                    </Button>
                                                                                </Grid>
                                                                            </Panel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>

                                                            <Separator Classes="menu-separator"
                                                                Margin="6,3" />

                                                            <!-- Строка создания нового пресета
                                                            внизу меню -->
                                                            <Border Padding="8,4"
                                                                CornerRadius="6"
                                                                BorderBrush="{DynamicResource BgHighlightTransparentBrush}"
                                                                BorderThickness="1">
                                                                <Grid ColumnDefinitions="22,*,Auto"
                                                                    VerticalAlignment="Center">
                                                                    <PathIcon Grid.Column="0"
                                                                        Width="14" Height="14"
                                                                        Data="{StaticResource Icon.Plus}"
                                                                        Foreground="{DynamicResource AccentBrush}"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center" />
                                                                    <TextBox
                                                                        x:Name="NewPresetTextBox"
                                                                        Grid.Column="1"
                                                                        Classes="flat-search-box"
                                                                        Text="{Binding NewPresetNameInput}"
                                                                        PlaceholderText="{Binding L[Eq_SavePreset_Watermark]}"
                                                                        FontSize="12"
                                                                        KeyDown="OnNewPresetTextBoxKeyDown" />
                                                                    <Button Grid.Column="2"
                                                                        Width="24" Height="24"
                                                                        Classes="icon-btn active"
                                                                        IsVisible="{Binding NewPresetNameInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                        Command="{Binding SaveInlineEqualizerPresetCommand}"
                                                                        ToolTip.Tip="{Binding L[Eq_SavePreset]}"
                                                                        ToolTip.Placement="Top"
                                                                        ToolTip.VerticalOffset="-6">
                                                                        <PathIcon Width="12"
                                                                            Height="12"
                                                                            Data="{StaticResource Icon.Check}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                            </Popup>
                                        </Panel>

                                        <!-- Блок 4: Квадратная кнопка 5 / 10 -->
                                        <Button Grid.Column="4" Width="28" Height="28" Padding="0"
                                            Margin="0,0,4,0" CornerRadius="6"
                                            Classes="icon-btn active"
                                            Command="{Binding ToggleEqualizerModeCommand}"
                                            Click="OnEqHeaderButtonClicked"
                                            ToolTip.Tip="{Binding L[Eq_Mode_Tooltip]}"
                                            ToolTip.Placement="Top"
                                            ToolTip.VerticalOffset="-6"
                                            ToolTip.ShowDelay="50">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Text="{Binding BandModeBadgeText}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Блок 5: Кнопка сброса (акцентная ТОЛЬКО когда
                                        CanResetEqualizer == true) -->
                                        <Button Grid.Column="5" Width="28" Height="28"
                                            Classes="icon-btn"
                                            Command="{Binding ResetEqualizerCommand}"
                                            Click="OnEqHeaderButtonClicked"
                                            ToolTip.Tip="{Binding L[Common_Reset]}"
                                            ToolTip.Placement="Top"
                                            ToolTip.VerticalOffset="-6"
                                            ToolTip.ShowDelay="50">
                                            <Panel>
                                                <PathIcon Width="14" Height="14"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Data="{StaticResource Icon.Refresh}"
                                                    IsVisible="{Binding !CanResetEqualizer}" />
                                                <PathIcon Width="14" Height="14"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    Data="{StaticResource Icon.Refresh}"
                                                    IsVisible="{Binding CanResetEqualizer}" />
                                            </Panel>
                                        </Button>
                                    </Grid>

                                    <!-- Волна занимает всё пространство снизу с увеличенной высотой -->
                                    <controls:EqualizerCurveControl
                                        x:Name="EqCurveControl"
                                        Height="185"
                                        Margin="-4,0,-4,-2"
                                        BandGains="{Binding EqualizerBandGains}"
                                        IsSimple5BandMode="{Binding IsSimple5BandMode}"
                                        IsEqEnabled="{Binding IsEqualizerEnabled}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border Width="1" Height="28" Margin="6,0"
                        Background="{DynamicResource BgHighlightBrush}" />
                    <Panel>
                        <Button x:Name="LikeButton" Width="40" Height="40" Classes="playback-btn"
                            Classes.active="{Binding IsLiked}"
                            Command="{Binding ToggleLikeCommand}" CornerRadius="20"
                            ToolTip.Tip="{Binding LikeTooltip}" ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-6">
                            <PathIcon Width="18" Height="18"
                                Data="{Binding IsLiked, Converter={StaticResource BoolToGeometryConverter}, ConverterParameter='Heart|HeartOutline'}" />
                        </Button>
                        <Popup ShouldUseOverlayLayer="True" HorizontalOffset="0"
                            IsLightDismissEnabled="False"
                            IsOpen="{Binding IsLikeHintVisible}" Placement="Top"
                            PlacementTarget="{Binding #LikeButton}" VerticalOffset="-8">
                            <Border Classes="mode-hint"
                                Classes.visible="{Binding IsLikeHintVisible}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding LikeHintText}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <controls:CopyLinkButton CopyUrl="{Binding CurrentTrackUrl}"
                        SuccessText="{Binding L[Track_Copied]}"
                        ToolTipText="{Binding L[Track_CopyLink]}" ButtonSize="36" IconSize="16" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Margin="10,10"
                    Background="{DynamicResource BgHighlightBrush}" />
                <Grid Grid.Column="2" VerticalAlignment="Center" ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="52" Height="52" Margin="0,0,12,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BgHighlightBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="4">
                        <Panel>
                            <PathIcon Width="22" Height="22"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Data="{StaticResource Icon.MusicNote}"
                                IsVisible="{Binding SafeThumbnail, Converter={StaticResource NullToVisible}, ConverterParameter=invert}" />
                            <Image controls:SmartImage.Source="{Binding SafeThumbnail}"
                                controls:SmartImage.Quality="Low"
                                IsVisible="{Binding SafeThumbnail, Converter={StaticResource NullToVisible}}"
                                Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding SafeTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding SafeAuthor}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="3" Width="1" Margin="10,10"
                    Background="{DynamicResource BgHighlightBrush}" />
                <StackPanel Grid.Column="4" Width="230" VerticalAlignment="Center" Spacing="4">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left"
                            IsVisible="{Binding TotalTracksInQueue, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}"
                            Orientation="Horizontal" Spacing="3"
                            ToolTip.Tip="{Binding TrackNumberTooltip}" ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-6">
                            <TextBlock FontSize="12" FontWeight="Bold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="{Binding CurrentTrackIndexDisplay}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                Text="/" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding TotalTracksInQueue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                            Orientation="Horizontal" Spacing="2"
                            ToolTip.Tip="{Binding DurationTooltip}" ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-6">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="{Binding Position, Converter={StaticResource TimeSpanConverter}}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                Text="/" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Duration, Converter={StaticResource TimeSpanConverter}}" />
                        </StackPanel>
                    </Grid>
                    <Panel>
                        <Button x:Name="FormatButton" Padding="8,4" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Classes="format-btn"
                            Command="{Binding LoadFormatsCommand}"
                            IsVisible="{Binding ShowStreamInfo}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel MinWidth="250" Spacing="6" Margin="4">

                                        <!-- Шапка с заголовком и кнопкой принудительного обновления -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,6">
                                            <TextBlock Grid.Column="0"
                                                FontWeight="Bold"
                                                FontSize="13"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{Binding L[Stream_SelectQuality]}" />

                                            <Button Grid.Column="1"
                                                Width="26" Height="26"
                                                Classes="icon-btn"
                                                Command="{Binding ForceLoadFormatsCommand}"
                                                ToolTip.Tip="{Binding L[Stream_RefreshFormats]}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="6">
                                                <Panel Width="14" Height="14">
                                                    <PathIcon Width="14" Height="14"
                                                        Data="{StaticResource Icon.Refresh}"
                                                        Classes.spinning="{Binding IsFormatsLoading}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Panel>
                                            </Button>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="10"
                                            Margin="4,12"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding IsFormatsLoading}">
                                            <TextBlock Text="{Binding L[Nav_PleaseWait]}"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                FontSize="13"
                                                VerticalAlignment="Center" />
                                            <PathIcon Data="{StaticResource Icon.Sync}"
                                                Classes="spinning"
                                                Width="14" Height="14"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Табличная сетка на основе высокопроизводительного Grid -->
                                        <ItemsControl ItemsSource="{Binding AvailableFormats}"
                                            IsVisible="{Binding !IsFormatsLoading}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalAlignment="Stretch"
                                                        Margin="0,2"
                                                        Classes="format-item-btn"
                                                        Classes.active="{Binding IsActive}"
                                                        Command="{Binding $parent[UserControl].((vm:PlayerBarViewModel)DataContext).SwitchFormatCommand}"
                                                        CommandParameter="{Binding}">

                                                        <Grid
                                                            ColumnDefinitions="24, 45, 65, 45, *, 24, 45">

                                                            <!-- Столбец 0: Статус скачивания -->
                                                            <Panel Grid.Column="0">
                                                                <PathIcon Width="14" Height="14"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Data="{StaticResource Icon.CheckCircle}"
                                                                    IsVisible="{Binding IsDownloaded}" />
                                                            </Panel>

                                                            <!-- Столбец 1: Кодек (Opus/AAC) -->
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding Codec}"
                                                                VerticalAlignment="Center" />

                                                            <!-- Столбец 2: Битрейт с округлением на
                                                            лету -->
                                                            <TextBlock Grid.Column="2"
                                                                Text="{Binding Bitrate, StringFormat={}{0:F0} kbps}"
                                                                VerticalAlignment="Center" />

                                                            <!-- Столбец 3: Расширение в скобках -->
                                                            <TextBlock Grid.Column="3"
                                                                Text="{Binding Container, StringFormat=({0})}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                VerticalAlignment="Center" />

                                                            <!-- Столбец 4: Пружина-растяжка
                                                            (сдвигает индикатор и вес вправо) -->

                                                            <!-- Столбец 5: Динамик активного потока -->
                                                            <Panel Grid.Column="5">
                                                                <PathIcon Width="14" Height="14"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Data="{StaticResource Icon.VolumeHigh}"
                                                                    IsVisible="{Binding IsActive}" />
                                                            </Panel>

                                                            <!-- Столбец 6: Размер файла -->
                                                            <TextBlock Grid.Column="6"
                                                                HorizontalAlignment="Right"
                                                                FontSize="11"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                Text="{Binding SizeMbFormatted}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding StreamInfo}" />
                                <Ellipse Width="3" Height="3"
                                    Fill="{DynamicResource BgHighlightBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowNetworkStats}" />
                                <TextBlock FontSize="10"
                                    FontWeight="{Binding PingWeight}"
                                    Foreground="{Binding PingBrush}"
                                    Text="{Binding PingText}"
                                    IsVisible="{Binding ShowNetworkStats}"
                                    VerticalAlignment="Center" />
                                <Ellipse Width="3" Height="3"
                                    Fill="{DynamicResource BgHighlightBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowNetworkStats}" />
                                <TextBlock FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding NetworkSpeedText}"
                                    IsVisible="{Binding ShowNetworkStats}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>