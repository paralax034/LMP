<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section: Flyouts & Popups Instancy -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Применяется к корневым нативным окнам всплывающих элементов -->
    <Style Selector="PopupRoot">
    </Style>

    <Style Selector="Button.icon-btn.popup-open">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.format-btn">
        <Setter Property="Background" Value="{DynamicResource BgHighlightTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.format-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.format-btn.popup-open">
        <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Grid.track-container">
        <Setter Property="RenderTransform" Value="scaleY(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"
                    Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.seek-container:pointerover Grid.track-container">
        <Setter Property="RenderTransform" Value="scaleY(2.0)" />
    </Style>
    <Style Selector="Grid.seek-container.dragging Grid.track-container">
        <Setter Property="RenderTransform" Value="scaleY(2.0)" />
    </Style>

    <!-- СТИЛИЗАЦИЯ ПРЯМОУГОЛЬНОГО БЕГУНКА -->
    <Style Selector="Grid.seek-container Border.slider-thumb">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.seek-container:pointerover Border.slider-thumb">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.seek-container.dragging Border.slider-thumb">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.seek-cursor">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.seek-container:pointerover Border.seek-cursor">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="Border.seek-preview-cursor">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.seek-preview-cursor.active">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- ИСПРАВЛЕНИЕ XAMLX CRASH -->
    <Style Selector="Border.progress-bar">
    </Style>
    <Style Selector="Grid.dragging Border.progress-bar">
    </Style>

    <!-- Section: Volume Thumb Styles -->
    <Style Selector="Ellipse.vol-thumb">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Ellipse.vol-thumb:pointerover">
        <Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Ellipse.vol-thumb.dragging">
        <Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Ellipse.vol-thumb.boosted">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.vol-track">
        <Setter Property="Background" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Border.vol-fill">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.vol-fill.dragging">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Border.vol-fill.boosted">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.playback-btn.auto-enabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.playback-btn.auto-enabled:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="Border.mode-hint">
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.mode-hint.visible">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ФОРМАТЫ СТРИМА: Стабильная геометрия без scale и без изменения толщины границ -->
    <Style Selector="Button.format-item-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentTransparentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.format-item-btn /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.format-item-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.format-item-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.format-item-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style
        Selector="Button.format-item-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style
        Selector="Button.format-item-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.format-item-btn:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.format-item-btn:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.format-item-btn:pressed TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.format-item-btn.active">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.format-item-btn.active:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
</Styles>