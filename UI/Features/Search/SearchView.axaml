<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Search"
    xmlns:controls="using:LMP.UI.Controls"
    xmlns:b="using:LMP.UI.Behaviors"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    x:Class="LMP.UI.Features.Search.SearchView"
    x:DataType="vm:SearchViewModel">

    <UserControl.Styles>
        <!-- Large input field spanning full header height (18px) over the base flat-search-box -->
        <Style Selector="TextBox.flat-search-box">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <!-- Minimalist interactive chips with maximum width constraint -->
        <Style Selector="Border.ribbon-chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ribbon-chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, 2, 38, *">

        <!-- ROW 0: FLAT HEADER STRIP -->
        <Border Grid.Row="0" Classes="header-strip">
            <Grid ColumnDefinitions="Auto, *, Auto" Height="46">

                <!-- 1. LEFT: MONOLITHIC FULL-HEIGHT COUNTER WITH A SINGLE RIGHT BORDER -->
                <Border Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BgHighlightBrush}"
                    BorderThickness="0,0,1,0"
                    MinWidth="48"
                    Padding="12,0"
                    VerticalAlignment="Stretch"
                    ToolTip.Tip="{Binding BadgeTooltip}">
                    <TextBlock Text="{Binding BadgeCount}"
                        FontSize="13"
                        FontWeight="Bold"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <!-- 2. CENTER: LARGE FLAT INPUT WITH AN INDEPENDENT GHOST TEXT LAYER -->
                <Grid Grid.Column="1" Margin="12,0" Height="44" VerticalAlignment="Center">
                    <TextBlock
                        IsVisible="{Binding HasGhostText}"
                        FontSize="18"
                        FontWeight="Normal"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Opacity="0.45"
                        IsHitTestVisible="False">
                        <Run Text="{Binding SearchQuery}" Foreground="Transparent" />
                        <Run Text="{Binding GhostTextSuffix}"
                            Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBlock>

                    <!-- Tab and Right keys are handled in code-behind during the tunneling phase to
                    protect caret navigation -->
                    <TextBox Name="SearchBox"
                        Classes="flat-search-box"
                        Text="{Binding SearchQuery}"
                        PlaceholderText="{Binding L[Search_Placeholder]}"
                        Height="44"
                        AcceptsReturn="False"
                        AcceptsTab="False">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearQueryCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Grid>

                <!-- 3. RIGHT: ACTIONS, FULL-HEIGHT DIVIDER AND SOURCES -->
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch">

                    <!-- Clear text button [X] -->
                    <Button Classes="header-icon-btn"
                        Command="{Binding ClearQueryCommand}"
                        IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Binding L[Search_ClearQuery]}"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                    </Button>

                    <!-- Clear history button (broom) -->
                    <Button Classes="header-icon-btn"
                        Command="{Binding ClearHistoryCommand}"
                        IsVisible="{Binding HasRecentSearches}"
                        ToolTip.Tip="{Binding L[Search_ClearHistory]}"
                        Margin="0,0,2,0"
                        VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.Broom}" Width="16" Height="16" />
                    </Button>

                    <!-- Refresh from network button on cache hit -->
                    <Button Classes="header-icon-btn"
                        Command="{Binding ForceSearchCommand}"
                        IsVisible="{Binding IsFromCache}"
                        ToolTip.Tip="{Binding L[Search_FromCache_Tooltip]}"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.Refresh}"
                            Width="16" Height="16" />
                    </Button>

                    <!-- FULL-HEIGHT DIVIDER WITH 1PX THICKNESS -->
                    <Border Width="1"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource BgHighlightBrush}"
                        Margin="4,0,8,0" />

                    <!-- CONTENT SOURCES -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                        <Button Classes="header-icon-btn"
                            Classes.active="{Binding IsSourceYtm}"
                            Command="{Binding SetSourceCommand}"
                            CommandParameter="YouTubeMusic"
                            ToolTip.Tip="{Binding L[Search_Source_YouTubeMusic]}">
                            <PathIcon Data="{StaticResource Icon.MusicCircle}" />
                        </Button>

                        <Button Classes="header-icon-btn"
                            Classes.active="{Binding IsSourceYt}"
                            Command="{Binding SetSourceCommand}"
                            CommandParameter="YouTube"
                            ToolTip.Tip="{Binding L[Search_Source_YouTube]}">
                            <PathIcon Data="{StaticResource Icon.Youtube}" />
                        </Button>

                        <Button Classes="header-icon-btn"
                            Classes.active="{Binding IsSourceLocal}"
                            Command="{Binding SetSourceCommand}"
                            CommandParameter="Local"
                            ToolTip.Tip="{Binding L[Search_Source_Local]}">
                            <PathIcon Data="{StaticResource Icon.DatabaseSearch}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: NEON LOADING LINE ALONG THE HEADER BORDER -->
        <ProgressBar Grid.Row="1"
            Height="2"
            IsIndeterminate="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Foreground="{DynamicResource AccentBrush}"
            Background="Transparent"
            BorderThickness="0" />

        <!-- ROW 2: HORIZONTAL SUGGESTIONS AND HISTORY RIBBON (CHIPS RIBBON) -->
        <Border Grid.Row="2"
            Classes="header-strip"
            Height="38"
            Padding="16,4">
            <Panel VerticalAlignment="Center">

                <!-- Placeholder when no suggestions are available: prevents grid layout shifts -->
                <TextBlock Text="{Binding RibbonPlaceholderText}"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !HasSuggestions}" />

                <!-- ScrollViewer with adaptive dynamic edge mask -->
                <ScrollViewer Name="RibbonScrollViewer"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    IsVisible="{Binding HasSuggestions}">

                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchSuggestionItem">
                                <!-- Interactive chip: Left Click — select, Right Click / ContextMenu — delete -->
                                <Border Classes="ribbon-chip"
                                    PointerPressed="OnSuggestionPointerPressed"
                                    ContextRequested="OnSuggestionContextRequested">
                                    <TextBlock Text="{Binding Text}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- ROW 3: TRACK LIST WITH SCROLLBAR AT THE EXTREME SCREEN EDGE -->
        <Grid Grid.Row="3">

            <!-- INITIAL LOADING SKELETONS (12 ITEMS) -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding IsLoading}">
                <StackPanel Classes="breathing skeleton-list-container" Margin="24,12">
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                    <ContentControl Classes="track-skeleton-row" />
                </StackPanel>
            </ScrollViewer>

            <!-- MAIN TRACK SCROLLER (Scrollbar strictly at the right window edge) -->
            <ScrollViewer Name="ResultsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding !IsLoading}">
                <i:Interaction.Behaviors>
                    <b:InfiniteScrollBehavior Command="{Binding LoadMoreCommand}" Threshold="300" />
                </i:Interaction.Behaviors>

                <controls:TrackListControl Items="{Binding Items}"
                    FilterText="{Binding FilterQuery}"
                    IsLoading="{Binding IsLoading}"
                    IsLoadingMore="{Binding IsLoadingMore}"
                    IsFetchingFromNetwork="{Binding IsFetchingFromNetwork}"
                    ReachedEnd="{Binding ReachedEnd}"
                    LoadMoreCommand="{Binding LoadMoreCommand}"
                    UseSearchLoader="True"
                    Margin="16,0,16,80" />
            </ScrollViewer>

            <!-- EMPTY RESULT -->
            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                IsVisible="{Binding ShowEmptyState}">
                <PathIcon Data="{StaticResource Icon.MagnifyClose}"
                    Width="48" Height="48"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Opacity="0.6" />
                <TextBlock Text="{Binding ErrorMessage}"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextMutedBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>