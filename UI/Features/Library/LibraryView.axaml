<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Library"
    xmlns:local="using:LMP.UI.Converters"
    xmlns:controls="using:LMP.UI.Controls"
    x:Class="LMP.UI.Features.Library.LibraryView"
    x:DataType="vm:LibraryViewModel"
    x:Name="LibraryRoot">

    <UserControl.Styles>

        <!-- ========================================== -->
        <!--             HEADER STRIP STYLES            -->
        <!-- ========================================== -->

        <Style Selector="Border.header-strip">
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Border.stat-block">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTransparentBrush}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.stat-block:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.stat-block:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.stat-block:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.stat-block PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.stat-block TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.header-action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style Selector="Button.header-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.header-action-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.header-action-btn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.header-action-btn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- ========================================== -->
        <!--            PLAYLIST CARD STYLES            -->
        <!-- ========================================== -->

        <Style Selector="Button.playlist-card-inner">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="320" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style
            Selector="Button.playlist-card-inner:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.playlist-card-inner.is-active /template/ ContentPresenter#PART_ContentPresenter,
                         Button.playlist-card-inner.menu-open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style
            Selector="Button.playlist-card-inner:pointerover,
                         Button.playlist-card-inner.is-active,
                         Button.playlist-card-inner.menu-open">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.card-info">
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style
            Selector="Button.playlist-card-inner:pointerover Border.card-info,
                         Button.playlist-card-inner.is-active Border.card-info,
                         Button.playlist-card-inner.menu-open Border.card-info">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style
            Selector="Button.playlist-card-inner:pointerover TextBlock.card-title,
                         Button.playlist-card-inner.is-active TextBlock.card-title,
                         Button.playlist-card-inner.menu-open TextBlock.card-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.playlist-card-inner.is-liked TextBlock.card-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.playlist-skeleton">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="320" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ROW 0: HEADER STRIP -->
        <Border Grid.Row="0" Classes="header-strip">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">

                <!-- LEFT: Блоки статистики -->
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="0"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding !IsSyncing}"
                    Opacity="{Binding IsStatsVisible, Converter={StaticResource BoolToOpacity}}">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity"
                                Duration="0:0:0.4"
                                Easing="CubicEaseOut" />
                        </Transitions>
                    </StackPanel.Transitions>

                    <Border Classes="stat-block"
                        ToolTip.Tip="{Binding L[Library_Tip_PlaylistCount]}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource Icon.PlaylistMusic}" Width="16"
                                Height="16" />
                            <TextBlock Text="{Binding PlaylistCountText}" FontSize="13"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Classes="stat-block" ToolTip.Tip="{Binding L[Library_Tip_TrackCount]}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource Icon.MusicNote}" Width="16" Height="16" />
                            <TextBlock Text="{Binding TotalTracksText}" FontSize="13"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Classes="stat-block"
                        ToolTip.Tip="{Binding L[Library_Tip_TotalDuration]}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource Icon.ClockOutline}" Width="16"
                                Height="16" />
                            <TextBlock Text="{Binding TotalDurationText}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Border Classes="stat-block"
                        IsVisible="{Binding AvgTrackDurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Binding L[Library_Tip_AvgTrack]}">
                        <TextBlock Text="{Binding AvgTrackDurationText}" FontSize="12"
                            VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>

                    <Border Classes="stat-block"
                        IsVisible="{Binding AvgPlaylistDurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Binding L[Library_Tip_AvgPlaylist]}">
                        <TextBlock Text="{Binding AvgPlaylistDurationText}" FontSize="12"
                            VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                </StackPanel>

                <!-- CENTER: Синхронизация -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsSyncing}">
                    <PathIcon Data="{StaticResource Icon.Sync}"
                        Classes="spinning"
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                    <TextBlock Text="{Binding SyncStatus}"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                </StackPanel>

                <!-- RIGHT: Действия -->
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">

                    <Button Command="{Binding SyncAccountPlaylistsCommand}"
                        Classes="header-action-btn"
                        ToolTip.Tip="{Binding L[Library_SyncYoutube]}">
                        <Panel Width="20" Height="20" IsHitTestVisible="False">
                            <PathIcon Data="{StaticResource Icon.CloudSync}"
                                IsVisible="{Binding !IsSyncing}" />
                            <PathIcon Data="{StaticResource Icon.Cloud}"
                                Foreground="{DynamicResource AccentBrush}"
                                IsVisible="{Binding IsSyncing}" />
                        </Panel>
                    </Button>

                    <Button Command="{Binding OpenCreateCommand}"
                        Classes="header-action-btn"
                        IsEnabled="{Binding !IsSyncing}"
                        ToolTip.Tip="{Binding L[Library_CreatePlaylist]}">
                        <PathIcon Data="{StaticResource Icon.Plus}" IsHitTestVisible="False" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: SYNC PROGRESS -->
        <ProgressBar Grid.Row="1" Height="2" Margin="0" IsHitTestVisible="False"
            IsVisible="{Binding IsSyncing}"
            Minimum="0" Maximum="1"
            Value="{Binding SyncProgress}"
            Background="{DynamicResource BgHighlightBrush}"
            Foreground="{DynamicResource AccentBrush}"
            BorderThickness="0">
            <ProgressBar.Transitions>
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </ProgressBar.Transitions>
        </ProgressBar>

        <!-- ROW 2: CONTENT -->
        <Grid Grid.Row="2" Margin="0,8,0,0">

            <!-- SKELETON -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="!IsContentReady" />
                        <Binding Path="IsSyncing" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>

                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="24,4,24,100" IsHitTestVisible="False">
                    <Border Classes="playlist-skeleton" Margin="10">
                        <Grid RowDefinitions="220, *">
                            <Border Grid.Row="0" Background="{DynamicResource BgSkeletonBrush}"
                                CornerRadius="7,7,0,0" ClipToBounds="True" />
                            <Border Grid.Row="1" Classes="card-info" Padding="12,10,12,14">
                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <Border Height="12" Width="150" HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                    <Border Height="10" Width="90" HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="playlist-skeleton" Margin="10" Opacity="0.7">
                        <Grid RowDefinitions="220, *">
                            <Border Grid.Row="0" Background="{DynamicResource BgSkeletonBrush}"
                                CornerRadius="7,7,0,0" ClipToBounds="True" />
                            <Border Grid.Row="1" Classes="card-info" Padding="12,10,12,14">
                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <Border Height="12" Width="130" HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                    <Border Height="10" Width="100" HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="playlist-skeleton" Margin="10" Opacity="0.5">
                        <Grid RowDefinitions="220, *">
                            <Border Grid.Row="0" Background="{DynamicResource BgSkeletonBrush}"
                                CornerRadius="7,7,0,0" ClipToBounds="True" />
                            <Border Grid.Row="1" Classes="card-info" Padding="12,10,12,14">
                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <Border Height="12" Width="160" HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                    <Border Height="10" Width="80" HorizontalAlignment="Left"
                                        CornerRadius="3"
                                        Background="{DynamicResource BgSkeletonDeepBrush}"
                                        Classes="skeleton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </WrapPanel>
            </ScrollViewer>

            <!-- MAIN CONTENT -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsContentReady" />
                        <Binding Path="!IsSyncing" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>

                <StackPanel Margin="24,0,24,100">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                <Button Classes="playlist-card-inner"
                                    Classes.visible="{Binding IsVisible}"
                                    Classes.is-active="{Binding IsActive}"
                                    Classes.is-liked="{Binding IsLikedPlaylist}"
                                    Classes.menu-open="{Binding IsMenuOpen}"
                                    Command="{Binding OpenCommand}">

                                    <!-- Строго типизированный ContextMenu со 100% корректным
                                    локальным DataContext -->
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="OnPlaylistContextMenuOpened"
                                            Closed="OnPlaylistContextMenuClosed">
                                            <MenuItem Header="{Binding PlayMenuHeader}"
                                                Command="{Binding PlayCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{Binding PlayMenuIcon}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{Binding L[Playlist_Open]}"
                                                Command="{Binding OpenCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon
                                                        Data="{StaticResource Icon.FolderOpen}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{Binding L[EditPlaylist_Title]}"
                                                Command="{Binding EditCommand}"
                                                IsVisible="{Binding CanEdit}">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource Icon.Pencil}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{Binding L[Queue_AddAll]}"
                                                Command="{Binding AddToQueueCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon
                                                        Data="{StaticResource Icon.PlaylistPlus}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{Binding L[Track_CopyLink]}"
                                                Command="{Binding CopyLinkCommand}">
                                                <MenuItem.Icon>
                                                    <PathIcon
                                                        Data="{StaticResource Icon.LinkVariant}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <Separator Classes="menu-separator" />

                                            <MenuItem Header="{Binding L[Button_Delete]}"
                                                Command="{Binding DeleteCommand}"
                                                IsVisible="{Binding CanDelete}" Classes="danger">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource Icon.Delete}"
                                                        Width="16" Height="16" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Grid RowDefinitions="220,*">
                                        <!-- COVER AREA -->
                                        <Border Grid.Row="0" CornerRadius="7,7,0,0"
                                            ClipToBounds="True" IsHitTestVisible="False" Margin="0"
                                            Background="{DynamicResource BgSkeletonBrush}">
                                            <Grid>
                                                <Image
                                                    controls:SmartImage.Quality="High"
                                                    controls:SmartImage.Debounce="80"
                                                    controls:SmartImage.Source="{Binding ThumbnailUrl}"
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasThumbnail}" />

                                                <Border
                                                    Background="{DynamicResource BgSkeletonBrush}"
                                                    IsVisible="{Binding ShowPlaceholder}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                    <PathIcon
                                                        Data="{StaticResource Icon.PlaylistMusic}"
                                                        Width="72" Height="72"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <Border IsVisible="{Binding IsLikedPlaylist}"
                                                    Background="{DynamicResource BgSkeletonBrush}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                    <PathIcon Data="{StaticResource Icon.Heart}"
                                                        Width="64" Height="64"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.95" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- INFO AREA -->
                                        <Border Grid.Row="1" Classes="card-info"
                                            Padding="12,10,12,14">
                                            <StackPanel>
                                                <TextBlock Classes="card-title"
                                                    Text="{Binding Name}"
                                                    FontSize="13"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis"
                                                    IsHitTestVisible="False" />

                                                <TextBlock Text="{Binding AuthorDisplayText}"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1"
                                                    IsVisible="{Binding ShowAuthor}"
                                                    Margin="0,2,0,0"
                                                    ToolTip.Tip="{Binding AuthorTooltip}" />

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding FormattedTrackCount}"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        IsHitTestVisible="False" />

                                                    <PathIcon Data="{StaticResource Icon.Lock}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        IsVisible="{Binding IsPrivate}"
                                                        ToolTip.Tip="{Binding L[Playlist_Private_Tooltip],TargetNullValue=''}" />

                                                    <PathIcon Data="{StaticResource Icon.Link}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        IsVisible="{Binding IsUnlisted}"
                                                        ToolTip.Tip="{Binding L[Playlist_Unlisted_Tooltip],TargetNullValue=''}" />

                                                    <PathIcon
                                                        Data="{StaticResource Icon.CloudCheck}"
                                                        Width="12" Height="12"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        IsVisible="{Binding HasCloudSource}"
                                                        ToolTip.Tip="{Binding L[Playlist_Synced_Tooltip],TargetNullValue=''}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding !HasPlaylists}" HorizontalAlignment="Center"
                        Margin="0,60,0,0">
                        <PathIcon Data="{StaticResource Icon.PlaylistMusic}" Width="64" Height="64"
                            Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding L[Library_Empty]}" FontSize="16"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>