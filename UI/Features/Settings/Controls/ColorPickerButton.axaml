<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LMP.UI.Features.Settings.Controls"
    x:Class="LMP.UI.Features.Settings.Controls.ColorPickerButton"
    x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Button.color-btn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.color-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.color-swatch">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.color-btn:pointerover Border.color-swatch">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Button x:Name="ColorButton" Classes="color-btn" Click="OnButtonClick">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding HexText, ElementName=Root}"
                    FontFamily="Consolas, monospace"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    VerticalAlignment="Center" />
                <Border Classes="color-swatch"
                    Background="{Binding SwatchBrush, ElementName=Root}" />
            </StackPanel>
        </Button>

        <Popup x:Name="ColorPopup"
            PlacementTarget="{Binding #ColorButton}"
            Placement="BottomEdgeAlignedRight"
            IsLightDismissEnabled="True"
            WindowManagerAddShadowHint="False" />
    </Panel>
</UserControl>