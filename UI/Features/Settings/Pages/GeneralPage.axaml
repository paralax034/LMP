<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Settings.ViewModels"
    x:Class="LMP.UI.Features.Settings.Pages.GeneralPage"
    x:DataType="vm:GeneralSettingsViewModel"
    x:CompileBindings="True">

    <StackPanel Margin="32,24" Spacing="20">
        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,4">
            <PathIcon Grid.Column="0" Data="{StaticResource Icon.Settings}"
                Width="20" Height="20" VerticalAlignment="Center"
                Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Grid.Column="1" Classes="h2"
                Text="{Binding L[Settings_General]}"
                VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- "About and Updates" block with zero layout shift -->
        <Border Classes="card">
            <StackPanel Spacing="14">

                <!-- Top grid with fixed heights -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                    <!-- Row 0, Left column: Title and JIT / AOT profile -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_About_Section]}"
                            VerticalAlignment="Center" />
                        <Border BorderBrush="{DynamicResource BgHighlightBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            Background="Transparent">
                            <TextBlock Text="{Binding BuildProfileShort}" FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Row 0, Right column: All controls in a single stable line -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                        <!-- Load simulation button (active in Debug only) -->
                        <Button Classes="ghost-btn"
                            Command="{Binding SimulateUpdateFlowCommand}"
                            IsVisible="{Binding IsDebug}"
                            Height="28" Padding="10,0"
                            ToolTip.Tip="{Binding L[Settings_Update_SimulateTooltip]}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.Bug}" Width="12" Height="12"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{Binding L[Settings_Update_SimulateButton]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub repository link -->
                        <Button Classes="icon-btn ghost-btn"
                            Command="{Binding OpenGitHubRepoCommand}"
                            Width="28" Height="28" Padding="6"
                            ToolTip.Tip="{Binding L[Common_OpenGitHub]}">
                            <PathIcon Data="{StaticResource Icon.Web}" Width="14" Height="14"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Check for updates / Download button -->
                        <Button Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding CanCheckForUpdates}"
                            Height="28" Padding="12,0"
                            MinWidth="170">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                                <!-- Idle icon -->
                                <PathIcon Data="{StaticResource Icon.Refresh}"
                                    Width="12" Height="12"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsUpdateActionIdle}" />

                                <!-- Checking or downloading icon (rotating) -->
                                <PathIcon Data="{StaticResource Icon.Refresh}"
                                    Width="12" Height="12"
                                    Classes="spinning"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                    <PathIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="IsCheckingUpdates" />
                                            <Binding Path="IsDownloadingUpdate" />
                                        </MultiBinding>
                                    </PathIcon.IsVisible>
                                </PathIcon>

                                <!-- Idle text -->
                                <TextBlock Text="{Binding L[Settings_CheckUpdates]}"
                                    IsVisible="{Binding IsUpdateActionIdle}" FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- Checking text -->
                                <TextBlock Text="{Binding L[Settings_CheckingUpdates]}"
                                    IsVisible="{Binding IsCheckingUpdates}" FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- Downloading text -->
                                <TextBlock Text="{Binding DownloadProgressText}"
                                    IsVisible="{Binding IsDownloadingUpdate}" FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Download update button (shown only when the archive is not yet
                        downloaded) -->
                        <Button Classes="primary-btn"
                            Content="{Binding L[Settings_DownloadUpdate]}"
                            Command="{Binding DownloadUpdateCommand}"
                            IsVisible="{Binding CanDownloadUpdate}"
                            Height="28" Padding="12,0" />

                        <!-- Restart and apply button (shown instead of the download
                        button) -->
                        <Button Classes="primary-btn"
                            Content="{Binding L[Settings_RestartToApply]}"
                            Command="{Binding ApplyUpdateCommand}"
                            IsVisible="{Binding IsUpdateReadyToInstall}"
                            Height="28" Padding="12,0" />
                    </StackPanel>

                    <!-- Row 1: Metadata on the left and status on the right -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        ColumnDefinitions="Auto, *, Auto" Height="24" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">

                            <!-- Commit count -->
                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_Commit]}">
                                <TextBlock Text="{Binding GitCommitCount}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- Commit hash -->
                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_Hash]}">
                                <TextBlock Text="{Binding GitCommitHash}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- Build date -->
                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_BuildDate]}">
                                <TextBlock Text="{Binding BuildDateString}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- GitHub repository metadata -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasRepoInfo}"
                                VerticalAlignment="Center">

                                <!-- Stars -->
                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Stars]}">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Heart}" Width="10"
                                            Height="10" Foreground="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RepoStars}" FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Open Issues -->
                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Issues]}">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Bug}" Width="10"
                                            Height="10"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RepoIssuesDisplayString}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Git branch -->
                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Branch]}">
                                    <TextBlock Text="{Binding RepoBranch, StringFormat='git:{0}'}"
                                        FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Update status with smooth fade-in opacity -->
                        <TextBlock Grid.Column="2"
                            Text="{Binding UpdateStatusText}"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextAlignment="Right" />
                    </Grid>

                </Grid>

                <!-- Composite divider with zero shift (height is ALWAYS exactly 2px) -->
                <Panel Height="2" Margin="0,2,0,2">
                    <Border Height="1" Background="{DynamicResource BgHighlightBrush}"
                        VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                        Height="2" BorderThickness="0"
                        IsVisible="{Binding IsDownloadingUpdate}"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center" />
                </Panel>

                <!--  Auto-check settings  -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_AutoCheckUpdates]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_AutoCheckUpdatesDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}"
                        VerticalAlignment="Center" />
                </Grid>

                <!--  Auto-check interval  -->
                <Grid ColumnDefinitions="*, 200, 70"
                    IsEnabled="{Binding AutoCheckUpdates}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_UpdateInterval]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_UpdateIntervalDesc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1"
                        Minimum="1" Maximum="24"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UpdateCheckIntervalHours}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding UpdateIntervalDisplayString}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- General parameters -->
        <Border Classes="card">
            <StackPanel Spacing="16">

                <!--  Discord RPC  -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="{Binding L[General_Discord]}"
                                VerticalAlignment="Center" />
                            <Border Classes="feature-badge coming-soon" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L[Common_ComingSoon]}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="desc" Text="{Binding L[General_DiscordDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding DiscordRpcEnabled}"
                        IsEnabled="False"
                        VerticalAlignment="Center" />
                </Grid>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!--  Search cache  -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_SearchCache]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_SearchCacheDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSearchCache}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*, 200, 70"
                    IsEnabled="{Binding EnableSearchCache}">
                    <TextBlock Classes="label"
                        Text="{Binding L[Settings_SearchCacheTtl]}"
                        VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="15" Maximum="480"
                        Value="{Binding SearchCacheTtlMinutes}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding SearchCacheTtlMinutes,
                                          StringFormat='{}{0} min'}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>

                <!-- Maximum number of search suggestions -->
                <Grid ColumnDefinitions="*, 200, 70" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_MaxSuggestions]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_MaxSuggestionsDesc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1"
                        Minimum="3" Maximum="15"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding MaxSuggestionsCount}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding MaxSuggestionsCount}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!--  Reset  -->
                <Button Content="{Binding L[Storage_ResetApp]}"
                    Command="{Binding ResetLibraryCommand}"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource SystemErrorBrush}" />

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>