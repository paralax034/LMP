<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Settings.ViewModels"
    xmlns:ui="using:LMP.UI.Controls"
    x:Class="LMP.UI.Features.Settings.Pages.GeneralPage"
    x:DataType="vm:GeneralSettingsViewModel"
    x:CompileBindings="True">

    <StackPanel Margin="32,24" Spacing="20">
        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,4">
            <PathIcon Grid.Column="0" Data="{StaticResource Icon.Settings}"
                Width="20" Height="20" VerticalAlignment="Center"
                Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Grid.Column="1" Classes="h2"
                Text="{Binding L[Settings_General]}"
                VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- "About and Updates" block with zero layout shift -->
        <Border Classes="card">
            <StackPanel Spacing="14">

                <!-- Top grid with fixed heights -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                    <!-- Row 0, Left column: Title and JIT / AOT profile -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_About_Section]}"
                            VerticalAlignment="Center" />
                        <Border BorderBrush="{DynamicResource BgHighlightBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                            Background="Transparent">
                            <TextBlock Text="{Binding BuildProfileShort}" FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Row 0, Right column: All controls in a single stable line -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                        <!-- Load simulation button (active in Debug only) -->
                        <Button Classes="ghost-btn"
                            Command="{Binding SimulateUpdateFlowCommand}"
                            IsVisible="{Binding IsDebug}"
                            Height="28" Padding="10,0"
                            ToolTip.Tip="{Binding L[Settings_Update_SimulateTooltip]}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.Bug}" Width="12" Height="12"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{Binding L[Settings_Update_SimulateButton]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- GitHub repository link -->
                        <Button Classes="icon-btn ghost-btn"
                            Command="{Binding OpenGitHubRepoCommand}"
                            Width="28" Height="28" Padding="6"
                            ToolTip.Tip="{Binding L[Common_OpenGitHub]}">
                            <PathIcon Data="{StaticResource Icon.Web}" Width="14" Height="14"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Check for updates / Download button -->
                        <Button Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding CanCheckForUpdates}"
                            Height="28" Padding="12,0"
                            MinWidth="170">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                                <!-- Idle icon -->
                                <PathIcon Data="{StaticResource Icon.Refresh}"
                                    Width="12" Height="12"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsUpdateActionIdle}" />

                                <!-- Checking or downloading icon (rotating) -->
                                <PathIcon Data="{StaticResource Icon.Refresh}"
                                    Width="12" Height="12"
                                    Classes="spinning"
                                    Foreground="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                    <PathIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="IsCheckingUpdates" />
                                            <Binding Path="IsDownloadingUpdate" />
                                        </MultiBinding>
                                    </PathIcon.IsVisible>
                                </PathIcon>

                                <!-- Idle text -->
                                <TextBlock Text="{Binding L[Settings_CheckUpdates]}"
                                    IsVisible="{Binding IsUpdateActionIdle}" FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- Checking text -->
                                <TextBlock Text="{Binding L[Settings_CheckingUpdates]}"
                                    IsVisible="{Binding IsCheckingUpdates}" FontSize="12"
                                    VerticalAlignment="Center" />

                                <!-- Downloading text -->
                                <TextBlock Text="{Binding DownloadProgressText}"
                                    IsVisible="{Binding IsDownloadingUpdate}" FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Download update button -->
                        <Button Classes="primary-btn"
                            Content="{Binding L[Settings_DownloadUpdate]}"
                            Command="{Binding DownloadUpdateCommand}"
                            IsVisible="{Binding CanDownloadUpdate}"
                            Height="28" Padding="12,0" />

                        <!-- Restart and apply button -->
                        <Button Classes="primary-btn"
                            Content="{Binding L[Settings_RestartToApply]}"
                            Command="{Binding ApplyUpdateCommand}"
                            IsVisible="{Binding IsUpdateReadyToInstall}"
                            Height="28" Padding="12,0" />
                    </StackPanel>

                    <!-- Row 1: Metadata on the left and status on the right -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        ColumnDefinitions="Auto, *, Auto" Height="24" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">

                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_Commit]}">
                                <TextBlock Text="{Binding GitCommitCount}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_Hash]}">
                                <TextBlock Text="{Binding GitCommitHash}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <Border Classes="meta-chip"
                                ToolTip.Tip="{Binding L[Metadata_Tooltip_BuildDate]}">
                                <TextBlock Text="{Binding BuildDateString}" FontSize="11"
                                    FontFamily="Consolas, monospace"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasRepoInfo}"
                                VerticalAlignment="Center">

                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Stars]}">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Heart}" Width="10"
                                            Height="10" Foreground="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RepoStars}" FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Issues]}">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon.Bug}" Width="10"
                                            Height="10"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RepoIssuesDisplayString}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="meta-chip"
                                    ToolTip.Tip="{Binding L[Metadata_Tooltip_Branch]}">
                                    <TextBlock Text="{Binding RepoBranch, StringFormat='git:{0}'}"
                                        FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                            Text="{Binding UpdateStatusText}"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextAlignment="Right" />
                    </Grid>

                </Grid>

                <!-- Composite divider with zero shift (height is ALWAYS exactly 2px) -->
                <Panel Height="2" Margin="0,2,0,2">
                    <Border Height="1" Background="{DynamicResource BgHighlightBrush}"
                        VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                        Height="2" BorderThickness="0"
                        IsVisible="{Binding IsDownloadingUpdate}"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center" />
                </Panel>

                <!-- Auto-check settings -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_AutoCheckUpdates]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_AutoCheckUpdatesDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- Auto-check interval -->
                <Grid ColumnDefinitions="*, 200, 70"
                    IsEnabled="{Binding AutoCheckUpdates}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_UpdateInterval]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_UpdateIntervalDesc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1"
                        Minimum="1" Maximum="24"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding UpdateCheckIntervalHours}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding UpdateIntervalDisplayString}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Discord Rich Presence (Minimalist header + Live Preview + One-click Presets + Collapsible Details) -->
        <Border Classes="card">
            <StackPanel Spacing="16">

                <!-- Header row (minimal: status text shown only when not connected; dot tooltip shows user) -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.Discord}"
                                Width="16" Height="16"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock Classes="label"
                                Text="{Binding L[General_Discord]}"
                                VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7"
                                VerticalAlignment="Center"
                                IsVisible="{Binding DiscordRpcEnabled}"
                                ToolTip.Tip="{Binding DiscordStatusText}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding DiscordStatusColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </StackPanel>
                        <TextBlock Text="{Binding DiscordStatusText}"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            IsVisible="{Binding ShowDiscordStatusText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                        <Button Classes="icon-btn ghost-btn"
                            Command="{Binding ReconnectDiscordRpcCommand}"
                            IsVisible="{Binding DiscordRpcEnabled}"
                            Width="28" Height="28" Padding="6"
                            ToolTip.Tip="{Binding L[DiscordRpc_Reconnect_Tip]}">
                            <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                        </Button>
                        <ToggleSwitch IsChecked="{Binding DiscordRpcEnabled}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Active body: Live Preview + Presets + Collapsible Customization -->
                <StackPanel Spacing="14" IsVisible="{Binding DiscordRpcEnabled}">

                    <!-- Compact Discord Live Preview Card -->
                    <Border Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BgHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <Panel>
                            <!-- Active / Demo Activity Card -->
                            <StackPanel Spacing="10" IsVisible="{Binding DiscordPreview.IsVisibleInDiscord}">
                                <!-- Header line: "Listening to Lite Music Player" + optional DEMO badge -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                        Text="{Binding DiscordPreviewHeaderText}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                        IsVisible="{Binding DiscordPreview.IsDemoTrack}"
                                        BorderBrush="{DynamicResource BgHighlightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L[DiscordRpc_Preview_DemoBadge]}"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Cover + Track Metadata + Progress -->
                                <Grid ColumnDefinitions="Auto, *">
                                    <!-- 60x60 cover + optional corner animated badge -->
                                    <Panel Grid.Column="0" Width="60" Height="60"
                                        Margin="0,0,12,0" VerticalAlignment="Top">
                                        <Border CornerRadius="8" ClipToBounds="True"
                                            Background="{DynamicResource BgSecondaryBrush}"
                                            BorderBrush="{DynamicResource BgHighlightBrush}"
                                            BorderThickness="1">
                                            <Panel>
                                                <PathIcon Data="{StaticResource Icon.MusicNote}"
                                                    Width="24" Height="24"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding DiscordPreview.CoverUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                <Image ui:SmartImage.Source="{Binding DiscordPreview.CoverUrl}"
                                                    ui:SmartImage.Quality="Low"
                                                    Stretch="UniformToFill"
                                                    IsVisible="{Binding DiscordPreview.CoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </Panel>
                                        </Border>

                                        <!-- Corner badge (public playlist cover / listener avatar / custom image) -->
                                        <Border Width="22" Height="22" CornerRadius="11"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-4,-4"
                                            Background="{DynamicResource BgPrimaryBrush}"
                                            BorderBrush="{DynamicResource BgPrimaryBrush}"
                                            BorderThickness="2"
                                            ToolTip.Tip="{Binding DiscordPreview.SmallImageTooltip}"
                                            IsVisible="{Binding DiscordPreview.SmallImageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <Image ui:SmartImage.Source="{Binding DiscordPreview.SmallImageUrl}"
                                                ui:SmartImage.Quality="Low"
                                                Stretch="UniformToFill" />
                                        </Border>
                                    </Panel>

                                    <!-- Text stack + Progress bar -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiscordPreview.Details}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DiscordPreview.State}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            IsVisible="{Binding DiscordPreview.State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding DiscordPreview.LargeText}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            IsVisible="{Binding DiscordPreview.LargeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                        <!-- Live / frozen-when-paused progress bar -->
                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                            Margin="0,6,0,0"
                                            IsVisible="{Binding DiscordPreview.ShowProgressBar}">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource Icon.Pause}"
                                                    Width="9" Height="9"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding DiscordPreview.IsPaused}" />
                                                <TextBlock Text="{Binding DiscordPreview.ElapsedText}"
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                Value="{Binding DiscordPreview.ProgressPercent}"
                                                Maximum="100"
                                                Height="3"
                                                MinWidth="40"
                                                Margin="8,0"
                                                BorderThickness="0"
                                                VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                Text="{Binding DiscordPreview.DurationText}"
                                                FontFamily="Consolas, monospace"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Elapsed-only line -->
                                        <TextBlock Text="{Binding DiscordPreviewElapsedLabel}"
                                            FontFamily="Consolas, monospace"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Margin="0,4,0,0"
                                            IsVisible="{Binding DiscordPreview.ShowElapsedOnly}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Link Buttons Preview -->
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding DiscordPreview.HasButtons}">
                                    <Border Background="Transparent"
                                        BorderBrush="{DynamicResource BgHighlightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10,4"
                                        IsVisible="{Binding DiscordPreview.Button1Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DiscordPreview.Button1Label}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Background="Transparent"
                                        BorderBrush="{DynamicResource BgHighlightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10,4"
                                        IsVisible="{Binding DiscordPreview.Button2Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DiscordPreview.Button2Label}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hidden while paused placeholder -->
                            <TextBlock Text="{Binding L[DiscordRpc_Preview_Hidden]}"
                                FontSize="12"
                                Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,8"
                                IsVisible="{Binding !DiscordPreview.IsVisibleInDiscord}" />
                        </Panel>
                    </Border>

                    <!-- One-click style presets -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="format-item-btn"
                            Classes.active="{Binding IsDiscordPresetMinimal}"
                            Command="{Binding ApplyDiscordMinimalPresetCommand}"
                            Padding="12,5">
                            <TextBlock Text="{Binding L[DiscordRpc_Preset_Minimal]}" FontSize="12" />
                        </Button>
                        <Button Classes="format-item-btn"
                            Classes.active="{Binding IsDiscordPresetBalanced}"
                            Command="{Binding ApplyDiscordBalancedPresetCommand}"
                            Padding="12,5">
                            <TextBlock Text="{Binding L[DiscordRpc_Preset_Balanced]}" FontSize="12" />
                        </Button>
                        <Button Classes="format-item-btn"
                            Classes.active="{Binding IsDiscordPresetRich}"
                            Command="{Binding ApplyDiscordRichPresetCommand}"
                            Padding="12,5">
                            <TextBlock Text="{Binding L[DiscordRpc_Preset_Rich]}" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Collapsible Fine-Tuning & Advanced Settings -->
                    <Expander Header="{Binding L[DiscordRpc_Advanced]}"
                        HorizontalAlignment="Stretch"
                        IsExpanded="False">
                        <StackPanel Spacing="14" Margin="0,12,0,0">

                            <!-- Activity type -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ActivityType]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ActivityTypeDesc]}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordActivityTypeOptions}"
                                    SelectedItem="{Binding SelectedDiscordActivityType}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Compact member-list highlight -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_StatusDisplay]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_StatusDisplayDesc]}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordStatusDisplayOptions}"
                                    SelectedItem="{Binding SelectedDiscordStatusDisplay}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Details line format -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_DetailsFormat]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_DetailsFormatDesc]}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordDetailsFormatOptions}"
                                    SelectedItem="{Binding SelectedDiscordDetailsFormat}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Timestamp / progress mode -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_TimestampMode]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_TimestampModeDesc]}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordTimestampModeOptions}"
                                    SelectedItem="{Binding SelectedDiscordTimestampMode}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Paused behavior -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_PausedBehavior]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_PausedBehaviorDesc]}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordPausedBehaviorOptions}"
                                    SelectedItem="{Binding SelectedDiscordPausedBehavior}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Animated corner badge style -->
                            <Grid ColumnDefinitions="*, 16, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_BadgeStyle]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_BadgeStyleDesc]}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                    ItemsSource="{Binding DiscordBadgeStyleOptions}"
                                    SelectedItem="{Binding SelectedDiscordBadgeStyle}"
                                    MinWidth="220"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Custom GIF/WebP URL (shown only when BadgeStyle == Custom) -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsDiscordCustomBadgeSelected}">
                                <TextBox Text="{Binding DiscordCustomBadgeUrl, Mode=TwoWay}"
                                    PlaceholderText="{Binding L[DiscordRpc_CustomBadgePlaceholder]}"
                                    MaxLength="256"
                                    FontFamily="Consolas, monospace" />
                                <TextBlock Text="{Binding L[DiscordRpc_CustomBadgeInvalid]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemErrorBrush}"
                                    IsVisible="{Binding IsDiscordCustomBadgeUrlInvalid}" />
                            </StackPanel>

                            <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                            <!-- Clean duplicate artist prefix -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_StripAuthor]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_StripAuthorDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordStripAuthorFromTitle}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show album cover -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowCoverArt]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowCoverArtDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowCoverArt}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show playlist name -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowPlaylistName]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowPlaylistNameDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowPlaylistName}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Share clickable public playlist link -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowPublicPlaylistLink]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowPublicPlaylistLinkDesc]}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowPublicPlaylistLink}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show like heart (purple / outline) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowLikeStatus]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowLikeStatusDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowLikeStatus}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show repeat mode indicator -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowRepeatMode]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowRepeatModeDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowRepeatMode}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show shuffle mode indicator -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowShuffleMode]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowShuffleModeDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowShuffleMode}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show queue position (1/31) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowQueuePosition]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowQueuePositionDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowQueuePosition}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show YouTube link button -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowTrackButton]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowTrackButtonDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowTrackButton}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show listener's YouTube channel (opt-in) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowListenerChannel]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowListenerChannelDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowListenerChannel}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show GitHub link button -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowGitHubButton]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowGitHubButtonDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowGitHubButton}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- Show idle status -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ShowIdleStatus]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ShowIdleStatusDesc]}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordShowIdleStatus}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                            <!-- Custom Discord Application ID -->
                            <StackPanel Spacing="8">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="{Binding L[DiscordRpc_ClientId]}" />
                                    <TextBlock Classes="desc" Text="{Binding L[DiscordRpc_ClientIdDesc]}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 8, Auto">
                                    <TextBox Grid.Column="0"
                                        Text="{Binding DiscordCustomClientId, Mode=TwoWay}"
                                        PlaceholderText="{Binding L[DiscordRpc_ClientIdPlaceholder]}"
                                        MaxLength="24"
                                        FontFamily="Consolas, monospace" />
                                    <Button Grid.Column="2"
                                        Content="{Binding L[Common_Reset]}"
                                        Command="{Binding ResetDiscordClientIdCommand}"
                                        IsEnabled="{Binding DiscordCustomClientId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>

                                <TextBlock Text="{Binding L[DiscordRpc_ClientIdInvalid]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemErrorBrush}"
                                    IsVisible="{Binding IsDiscordCustomClientIdInvalid}" />
                            </StackPanel>

                        </StackPanel>
                    </Expander>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- General parameters -->
        <Border Classes="card">
            <StackPanel Spacing="16">

                <!-- Search cache -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_SearchCache]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_SearchCacheDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSearchCache}"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*, 200, 70"
                    IsEnabled="{Binding EnableSearchCache}">
                    <TextBlock Classes="label"
                        Text="{Binding L[Settings_SearchCacheTtl]}"
                        VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="15" Maximum="480"
                        Value="{Binding SearchCacheTtlMinutes}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding SearchCacheTtlMinutes,
                                          StringFormat='{}{0} min'}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>

                <!-- Maximum number of search suggestions -->
                <Grid ColumnDefinitions="*, 200, 70" Margin="0,8,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{Binding L[Settings_MaxSuggestions]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_MaxSuggestionsDesc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1"
                        Minimum="3" Maximum="15"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding MaxSuggestionsCount}"
                        VerticalAlignment="Center"
                        Margin="12,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding MaxSuggestionsCount}"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                </Grid>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!-- Reset -->
                <Button Content="{Binding L[Storage_ResetApp]}"
                    Command="{Binding ResetLibraryCommand}"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource SystemErrorBrush}" />

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>