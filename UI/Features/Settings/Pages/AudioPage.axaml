<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LMP.UI.Features.Settings.ViewModels"
    xmlns:controls="using:LMP.UI.Controls"
    xmlns:player="using:LMP.UI.Features.Player"
    x:Class="LMP.UI.Features.Settings.Pages.AudioPage"
    x:DataType="vm:AudioSettingsViewModel">

    <StackPanel Margin="32,24">
        <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,16">
            <PathIcon Grid.Column="0" Data="{StaticResource Icon.VolumeHigh}"
                Width="20" Height="20" VerticalAlignment="Center"
                Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Grid.Column="1" Classes="h2"
                Text="{Binding L[Settings_Audio]}"
                VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <Border Classes="card">
            <StackPanel Spacing="20">

                <!--  Volume  -->
                <TextBlock Text="{Binding L[Audio_VolumeSection]}"
                    FontWeight="SemiBold" FontSize="14"
                    Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid ColumnDefinitions="*, 250, 70">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Audio_MaxVolume]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Audio_MaxVolumeDesc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="100" Maximum="800"
                        Value="{Binding MaxVolumeLimit}"
                        Margin="0,0,10,0"
                        TickFrequency="100" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding MaxVolumeLimit, StringFormat='{}{0}%'}" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="{Binding L[Settings_VolumeBoost]}" />
                            <Border Classes="feature-badge">
                                <TextBlock Text="BOOST" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="desc" Text="{Binding L[Settings_VolumeBoost_Tooltip]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding VolumeBoostEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_VolumeCurve]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_VolumeCurve_Desc]}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                        ItemsSource="{Binding VolumeCurveOptions}"
                        SelectedItem="{Binding SelectedVolumeCurve}"
                        MinWidth="220" />
                </Grid>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!--  Processing  -->
                <TextBlock Text="{Binding L[Audio_ProcessingSection]}"
                    FontWeight="SemiBold" FontSize="14"
                    Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid ColumnDefinitions="*, Auto, Auto">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_AudioNormalization]}" />
                        <TextBlock Classes="desc"
                            Text="{Binding L[Settings_AudioNormalization_Tooltip]}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="transparent-btn"
                        Command="{Binding ShowNormalizationInfoCommand}"
                        Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding L[Settings_NormalizationHowItWorks]}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.AlertCircle}"
                                Width="16" Height="16"
                                Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding L[Settings_NormalizationHowItWorks]}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleSwitch Grid.Column="2"
                        IsChecked="{Binding AudioNormalizationEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto"
                    IsEnabled="{Binding AudioNormalizationEnabled}">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_NormalizationMode]}" />
                        <TextBlock Classes="desc"
                            Text="{Binding L[Settings_NormalizationMode_Desc]}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                        ItemsSource="{Binding NormalizationModeOptions}"
                        SelectedItem="{Binding SelectedNormalizationMode}"
                        MinWidth="260" />
                </Grid>

                <Grid ColumnDefinitions="*, 220, 70"
                    IsEnabled="{Binding AudioNormalizationEnabled}">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_NormalizationTarget]}" />
                        <TextBlock Classes="desc"
                            Text="{Binding L[Settings_NormalizationTarget_Desc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="-24" Maximum="-6"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding NormalizationTargetLufs}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding NormalizationTargetLufs, StringFormat='{}{0:F0} LUFS'}" />
                </Grid>

                <Border Background="{DynamicResource BgElevatedBrush}"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,4"
                    IsVisible="{Binding AudioNormalizationEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{StaticResource Icon.InformationOutline}"
                            Width="16" Height="16"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding L[Settings_NormalizationTarget_Note]}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="12" TextWrapping="Wrap" MaxWidth="600" />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*, 220, 70"
                    IsEnabled="{Binding AudioNormalizationEnabled}">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_NormalizationMaxGain]}" />
                        <TextBlock Classes="desc"
                            Text="{Binding L[Settings_NormalizationMaxGain_Desc]}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="1" Maximum="6"
                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding NormalizationMaxGain}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Classes="value-label"
                        Text="{Binding NormalizationMaxGain, StringFormat='{}{0:F1}x'}" />
                </Grid>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!--  Equalizer (EQ)  -->
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Equalizer}" Width="16" Height="16"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock Classes="label" Text="{Binding L[Eq_Title]}" />
                        </StackPanel>
                        <TextBlock Classes="desc" Text="{Binding L[Eq_Description]}" />
                    </StackPanel>

                    <!-- Кнопка: Единый для всех (Глобус) -->
                    <Button Grid.Column="1" Width="32" Height="32" CornerRadius="6"
                        Margin="0,0,6,0" VerticalAlignment="Center"
                        Classes="icon-btn"
                        Command="{Binding ToggleForceGlobalEqualizerCommand}"
                        Click="OnEqHeaderButtonClicked"
                        ToolTip.Tip="{Binding ForceGlobalEqualizerTooltip}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6"
                        ToolTip.ShowDelay="80">
                        <Panel>
                            <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Data="{StaticResource Icon.Web}"
                                IsVisible="{Binding !ForceGlobalEqualizer}" />
                            <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource AccentBrush}"
                                Data="{StaticResource Icon.Web}"
                                IsVisible="{Binding ForceGlobalEqualizer}" />
                        </Panel>
                    </Button>

                    <!-- Выпадающий список пресетов (только по наведению) -->
                    <Panel Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center"
                        PointerEntered="OnPresetsTriggerPointerEntered"
                        PointerExited="OnPresetsTriggerPointerExited">
                        <Button x:Name="SettingsPresetsButton" Padding="10,5"
                            CornerRadius="6" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding L[Eq_Presets_Tooltip]}"
                            ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                    Text="{Binding ActiveEqualizerPresetTitle}"
                                    MaxWidth="140" TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <PathIcon Width="11" Height="11"
                                    Data="{StaticResource Icon.ChevronUp}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Popup x:Name="SettingsPresetsPopup"
                            Placement="TopEdgeAlignedRight"
                            PlacementTarget="{Binding #SettingsPresetsButton}"
                            VerticalOffset="0"
                            IsLightDismissEnabled="False">
                            <Border x:Name="SettingsPresetsPopupRoot"
                                Padding="0,0,0,6" Background="Transparent"
                                PointerEntered="OnPresetsPopupPointerEntered"
                                PointerExited="OnPresetsPopupPointerExited">
                                <Border Width="230" Padding="4"
                                    Background="{DynamicResource BgPrimaryBrush}"
                                    BorderBrush="{DynamicResource BgHighlightBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    BoxShadow="{StaticResource CardShadow}">
                                    <StackPanel Spacing="2">
                                        <ScrollViewer MaxHeight="210"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl
                                                ItemsSource="{Binding EqualizerPresetsList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="player:EqualizerPresetChipItem">
                                                        <Panel>
                                                            <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="10,7" Margin="0,1"
                                                                Classes="format-item-btn"
                                                                Classes.active="{Binding IsSelected}"
                                                                IsVisible="{Binding !IsRenaming}"
                                                                ToolTip.Tip="{Binding RightClickHint}"
                                                                ToolTip.Placement="Top"
                                                                ToolTip.VerticalOffset="-4"
                                                                PointerReleased="OnPresetItemPointerReleased"
                                                                Command="{Binding $parent[UserControl].((vm:AudioSettingsViewModel)DataContext).SelectEqualizerPresetCommand}"
                                                                CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="22,*">
                                                                    <PathIcon Grid.Column="0"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Data="{StaticResource Icon.Check}"
                                                                        Foreground="{DynamicResource AccentBrush}"
                                                                        IsVisible="{Binding IsSelected}"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1"
                                                                        FontSize="12"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>

                                                            <Grid ColumnDefinitions="*,Auto"
                                                                ColumnSpacing="4"
                                                                Margin="0,1"
                                                                IsVisible="{Binding IsRenaming}">
                                                                <TextBox Grid.Column="0"
                                                                    Text="{Binding EditTitle}"
                                                                    FontSize="12" Padding="8,5"
                                                                    KeyDown="OnRenamePresetTextBoxKeyDown"
                                                                    LostFocus="OnRenamePresetTextBoxLostFocus" />
                                                                <Button Grid.Column="1" Width="28"
                                                                    Height="28"
                                                                    Classes="icon-btn active"
                                                                    Command="{Binding $parent[UserControl].((vm:AudioSettingsViewModel)DataContext).CommitRenamePresetCommand}"
                                                                    CommandParameter="{Binding}">
                                                                    <PathIcon Width="12" Height="12"
                                                                        Data="{StaticResource Icon.Check}" />
                                                                </Button>
                                                            </Grid>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Separator Classes="menu-separator" Margin="6,3" />

                                        <Border Padding="8,4" CornerRadius="6"
                                            BorderBrush="{DynamicResource BgHighlightTransparentBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnDefinitions="22,*,Auto"
                                                VerticalAlignment="Center">
                                                <PathIcon Grid.Column="0" Width="14" Height="14"
                                                    Data="{StaticResource Icon.Plus}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" />
                                                <TextBox x:Name="NewPresetTextBox" Grid.Column="1"
                                                    Classes="flat-search-box"
                                                    Text="{Binding NewPresetNameInput}"
                                                    PlaceholderText="{Binding L[Eq_SavePreset_Watermark]}"
                                                    FontSize="12"
                                                    KeyDown="OnNewPresetTextBoxKeyDown" />
                                                <Button Grid.Column="2" Width="24" Height="24"
                                                    Classes="icon-btn"
                                                    IsVisible="{Binding NewPresetNameInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Command="{Binding SaveInlinePresetCommand}"
                                                    ToolTip.Tip="{Binding L[Eq_SavePreset]}"
                                                    ToolTip.Placement="Top"
                                                    ToolTip.VerticalOffset="-6">
                                                    <PathIcon Width="12" Height="12"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Data="{StaticResource Icon.Check}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Popup>
                    </Panel>

                    <!-- Квадратная кнопка 5 / 10 -->
                    <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                        Margin="0,0,6,0" CornerRadius="6" VerticalAlignment="Center"
                        Classes="icon-btn active"
                        Command="{Binding ToggleEqualizerModeCommand}"
                        Click="OnEqHeaderButtonClicked"
                        ToolTip.Tip="{Binding L[Eq_Mode_Tooltip]}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6"
                        ToolTip.ShowDelay="80">
                        <TextBlock FontSize="12" FontWeight="Bold"
                            Foreground="{DynamicResource AccentBrush}"
                            Text="{Binding BandModeBadgeText}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Button>

                    <!-- Кнопка сброса иконкой (акцентная ТОЛЬКО когда CanResetEqualizer == true) -->
                    <Button Grid.Column="4" Width="32" Height="32"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes="icon-btn"
                        Command="{Binding ResetEqualizerCommand}"
                        Click="OnEqHeaderButtonClicked"
                        ToolTip.Tip="{Binding L[Common_Reset]}"
                        ToolTip.Placement="Top"
                        ToolTip.VerticalOffset="-6"
                        ToolTip.ShowDelay="80">
                        <Panel>
                            <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Data="{StaticResource Icon.Refresh}"
                                IsVisible="{Binding !CanResetEqualizer}" />
                            <PathIcon Width="15" Height="15"
                                Foreground="{DynamicResource AccentBrush}"
                                Data="{StaticResource Icon.Refresh}"
                                IsVisible="{Binding CanResetEqualizer}" />
                        </Panel>
                    </Button>

                    <!-- Тумблер питания -->
                    <ToggleSwitch Grid.Column="5" IsChecked="{Binding EqualizerEnabled}"
                        VerticalAlignment="Center" />
                </Grid>

                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BgHighlightBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="6">
                        <controls:EqualizerCurveControl
                            x:Name="SettingsEqCurveControl"
                            Height="185"
                            BandGains="{Binding EqualizerBandGains}"
                            IsSimple5BandMode="{Binding UseSimple5BandMode}"
                            IsEqEnabled="{Binding EqualizerEnabled}" />
                    </Border>

                    <Grid ColumnDefinitions="*, 220, 70">
                        <StackPanel>
                            <TextBlock Classes="label" Text="{Binding L[Eq_ManualPreamp]}" />
                            <TextBlock Classes="desc" Text="{Binding L[Eq_ManualPreamp_Desc]}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="-12" Maximum="12"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding EqualizerPreampDb}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Classes="value-label"
                            Text="{Binding EqualizerPreampDb, StringFormat='{}{0:F1} dB'}" />
                    </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource BgHighlightBrush}" Height="1" />

                <!--  Quality  -->
                <TextBlock Text="{Binding L[Audio_QualitySection]}"
                    FontWeight="SemiBold" FontSize="14"
                    Foreground="{DynamicResource TextSecondaryBrush}" />

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_AudioQuality]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_AudioQualityDesc]}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                        ItemsSource="{Binding QualityOptions}"
                        SelectedItem="{Binding SelectedQualityItem}"
                        MinWidth="200" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{Binding L[Settings_RememberFormat]}" />
                        <TextBlock Classes="desc" Text="{Binding L[Settings_RememberFormatDesc]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberTrackFormat}" />
                </Grid>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>