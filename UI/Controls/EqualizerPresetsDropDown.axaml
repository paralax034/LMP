<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LMP.UI.Controls"
    x:Class="LMP.UI.Controls.EqualizerPresetsDropDown"
    x:DataType="controls:EqualizerScopeViewModel">

    <Panel PointerEntered="OnPresetsTriggerPointerEntered"
        PointerExited="OnPresetsTriggerPointerExited">
        <Button x:Name="PresetsTriggerButton"
            Padding="10,5"
            CornerRadius="6"
            VerticalAlignment="Center"
            Click="OnPresetsTriggerButtonClicked"
            ToolTip.Tip="{Binding L[Eq_Presets_Tooltip]}"
            ToolTip.Placement="Top"
            ToolTip.VerticalOffset="-6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="ActivePresetTitleText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding ActiveEqualizerPresetTitle}"
                    MaxWidth="140"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <PathIcon x:Name="ChevronIcon"
                    Width="11"
                    Height="11"
                    Data="{StaticResource Icon.ChevronUp}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Popup x:Name="PresetsPopup"
            ShouldUseOverlayLayer="True"
            Placement="TopEdgeAlignedRight"
            PlacementTarget="{Binding #PresetsTriggerButton}"
            VerticalOffset="0"
            IsLightDismissEnabled="False">
            <Border x:Name="PresetsPopupRoot"
                Padding="0,0,0,6"
                Background="Transparent"
                PointerEntered="OnPresetsPopupPointerEntered"
                PointerExited="OnPresetsPopupPointerExited">
                <Border Width="230"
                    Padding="4"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BgHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="{StaticResource CardShadow}">
                    <StackPanel Spacing="2">
                        <ScrollViewer MaxHeight="210"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding EqualizerPresetsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:EqualizerPresetChipItem">
                                        <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,7"
                                            Margin="0,1"
                                            Classes="format-item-btn"
                                            Classes.active="{Binding IsSelected}"
                                            ToolTip.Tip="{Binding RightClickHint}"
                                            ToolTip.Placement="Top"
                                            ToolTip.VerticalOffset="-4"
                                            Click="OnPresetItemClicked"
                                            PointerReleased="OnPresetItemPointerReleased">
                                            <Grid ColumnDefinitions="22,*,Auto">
                                                <PathIcon Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Data="{StaticResource Icon.Check}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding IsSelected}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                    FontSize="12"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <PathIcon Grid.Column="2"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="6,0,0,0"
                                                    Data="{StaticResource Icon.MusicNote}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding IsTrackPreset}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Classes="menu-separator" Margin="6,3" />

                        <Border Padding="8,4"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource BgHighlightTransparentBrush}"
                            BorderThickness="1">
                            <Grid ColumnDefinitions="22,*,Auto" VerticalAlignment="Center">
                                <PathIcon Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Data="{StaticResource Icon.Plus}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                                <TextBox x:Name="NewPresetTextBox"
                                    Grid.Column="1"
                                    Classes="flat-search-box"
                                    Text="{Binding NewPresetNameInput}"
                                    PlaceholderText="{Binding L[Eq_SavePreset_Watermark]}"
                                    FontSize="12"
                                    KeyDown="OnNewPresetTextBoxKeyDown" />
                                <Button Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Classes="icon-btn active"
                                    IsVisible="{Binding NewPresetNameInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Command="{Binding SaveInlineEqualizerPresetCommand}"
                                    ToolTip.Tip="{Binding L[Eq_SavePreset]}"
                                    ToolTip.Placement="Top"
                                    ToolTip.VerticalOffset="-6">
                                    <PathIcon Width="12"
                                        Height="12"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Data="{StaticResource Icon.Check}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Panel>
</UserControl>