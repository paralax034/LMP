<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:LMP.UI.Controls"
    x:Class="LMP.UI.Controls.CopyLinkButton"
    x:DataType="ctrl:CopyLinkButton"
    x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Button.copy-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.copy-btn:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.copy-btn:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Button.copy-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.copy-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.copy-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style
            Selector="Button.copy-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.copy-btn PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.LinkVariant}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.copy-btn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.copy-btn:pressed PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.copy-btn.success PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Check}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.copy-btn.error PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Close}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Button x:Name="CopyButton"
            Classes="copy-btn"
            Click="OnClick"
            Width="{Binding ButtonSize, ElementName=Root}"
            Height="{Binding ButtonSize, ElementName=Root}"
            CornerRadius="999"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            ToolTip.Tip="{Binding ToolTipText, ElementName=Root}"
            ToolTip.Placement="Top"
            ToolTip.VerticalOffset="-6">

            <PathIcon x:Name="LinkIcon"
                Width="{Binding IconSize, ElementName=Root}"
                Height="{Binding IconSize, ElementName=Root}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Button>

        <Popup x:Name="HintPopup"
            Placement="Top"
            PlacementTarget="{Binding #CopyButton}"
            IsLightDismissEnabled="False"
            IsHitTestVisible="False"
            Topmost="True"
            VerticalOffset="-8">
            <Border x:Name="HintBorder"
                Padding="10,6"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BgHighlightBrush}"
                BorderThickness="1"
                BoxShadow="{StaticResource CardShadow}"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon x:Name="HintIcon"
                        Width="13" Height="13"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icon.Check}"
                        Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="HintText"
                        FontSize="11" FontWeight="Medium"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Popup>
    </Panel>
</UserControl>