<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="using:LMP.UI.Dialogs"
    xmlns:controls="using:LMP.UI.Controls"
    x:Class="LMP.UI.Controls.PlaylistCoverPicker"
    x:DataType="d:PlaylistCoverPickerViewModel">

    <UserControl.Styles>
        <Style Selector="Button.cover-cell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.cover-cell:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.cover-cell.is-selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Шапка: счетчик и подсказка -->
        <Border Grid.Row="0" Margin="0,0,0,6" Padding="0,0,0,4"
            BorderBrush="{DynamicResource BgHighlightBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                    Text="{Binding L[CoverPicker_SelectTracks]}"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"
                    VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                    Text="{Binding SelectionStatus}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Сетка треков: строгая высота 140px, 2 полных ряда по 50px -->
        <ScrollViewer Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Height="140">
            <ItemsRepeater ItemsSource="{Binding TrackCovers}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="46"
                        MinItemHeight="46"
                        MinColumnSpacing="5"
                        MinRowSpacing="5"
                        ItemsStretch="Uniform" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="d:TrackCoverItemViewModel">
                        <Button Command="{Binding ToggleCommand}"
                            Classes="cover-cell"
                            Classes.is-selected="{Binding IsSelected}"
                            Width="46" Height="46"
                            ToolTip.Tip="{Binding TrackTitle}">
                            <Border CornerRadius="4" ClipToBounds="True">
                                <Panel>
                                    <Image controls:SmartImage.Source="{Binding ThumbnailUrl}"
                                        controls:SmartImage.Quality="Low"
                                        controls:SmartImage.Debounce="60"
                                        Stretch="UniformToFill"
                                        Width="46" Height="46" />

                                    <Border Background="#60000000"
                                        IsVisible="{Binding IsSelected}" />

                                    <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="0,0,4,0"
                                        Padding="3,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding IsSelected}">
                                        <TextBlock Text="{Binding SelectionOrder}"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentButtonTextBrush}" />
                                    </Border>
                                </Panel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>