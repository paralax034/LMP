<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:LMP.UI.Dialogs"
    x:Class="LMP.UI.Dialogs.Content.DeletePlaylistDialogContent"
    x:DataType="dialogs:DeletePlaylistDialogViewModel">

    <UserControl.Styles>
        <Style Selector="Border.option-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BgHighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.option-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgElevatedTransparentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BgHighlightBrush}"
        BorderThickness="1"
        CornerRadius="12"
        BoxShadow="0 20 48 0 #66000000"
        Padding="24"
        Width="440">

        <StackPanel Spacing="20">

            <!-- Заголовок с иконкой -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{DynamicResource SystemErrorBgBrush}"
                    CornerRadius="20" Width="40" Height="40">
                    <PathIcon Data="{StaticResource Icon.DeleteOutline}"
                        Width="20" Height="20"
                        Foreground="{DynamicResource SystemErrorBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding L[Delete_Title]}"
                        FontSize="18" FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PlaylistName}"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Описание -->
            <TextBlock Text="{Binding L[Delete_Description]}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextSecondaryBrush}"
                FontSize="13" />

            <!-- Опции удаления -->
            <StackPanel Spacing="8">
                <Border Classes="option-card">
                    <!-- Опция: только локально -->
                    <RadioButton IsChecked="{Binding IsLocalOnly}" GroupName="DeleteMode">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,0">
                            <PathIcon Data="{StaticResource Icon.FolderRemove}"
                                Width="24" Height="24"
                                Foreground="{DynamicResource TextSecondaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding L[Delete_LocalOnly]}"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding L[Delete_LocalOnlyHint]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </Border>

                <Border Classes="option-card"
                    IsVisible="{Binding CanDeleteFromCloud}">
                    <!-- Опция: везде (включая облако) -->
                    <RadioButton IsChecked="{Binding IsDeleteEverywhere}" GroupName="DeleteMode">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,0">
                            <PathIcon Data="{StaticResource Icon.CloudOff}"
                                Width="24" Height="24"
                                Foreground="{DynamicResource SystemErrorBrush}" />
                            <StackPanel>
                                <TextBlock Text="{Binding L[Delete_Everywhere]}"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding L[Delete_EverywhereHint]}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </Border>
            </StackPanel>

            <!-- Кнопки -->
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                <Panel />
                <Button Grid.Column="1"
                    Content="{Binding L[Button_Cancel]}"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    MinWidth="80" Margin="0,0,12,0" />
                <Button Grid.Column="2"
                    Content="{Binding L[Button_Delete]}"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="100"
                    Background="{DynamicResource SystemErrorBrush}"
                    Foreground="White" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>