<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:LMP.UI.Dialogs"
    xmlns:controls="using:LMP.UI.Controls"
    x:Class="LMP.UI.Dialogs.Content.EditPlaylistDialogContent"
    x:DataType="dialogs:EditPlaylistDialogViewModel">

    <Border Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BgHighlightBrush}"
        BorderThickness="1"
        CornerRadius="12"
        BoxShadow="0 20 48 0 #66000000"
        Padding="22"
        Width="700"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Grid RowDefinitions="Auto, Auto, Auto">

            <!-- Заголовок в чистом стиле CreatePlaylist -->
            <TextBlock Grid.Row="0"
                Text="{Binding L[EditPlaylist_Title]}"
                FontSize="18" FontWeight="Bold"
                Margin="0,0,0,16" />

            <!-- Тело редактора -->
            <controls:PlaylistEditorControl Grid.Row="1"
                DataContext="{Binding Editor}" />

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="12"
                Margin="0,16,0,0">
                <Button Content="{Binding L[Common_Cancel]}"
                    Command="{Binding CancelCommand}"
                    Background="Transparent" />
                <Button Content="{Binding L[Common_Apply]}"
                    Command="{Binding SaveCommand}"
                    Classes="accent accent-base" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>