<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:LMP.UI.Dialogs"
    xmlns:controls="using:LMP.UI.Controls"
    x:Class="LMP.UI.Dialogs.Content.SyncPlaylistDialogContent"
    x:DataType="dialogs:SyncPlaylistDialogViewModel">

    <Border Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BgHighlightBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="24"
        Width="560"
        MinHeight="420"
        MaxHeight="720">

        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Header: CloudSync + заголовок -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource Icon.CloudSync}"
                    Width="24" Height="24"
                    Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding L[Dialog_SyncPlaylist_Title]}"
                    FontSize="20" FontWeight="Bold" />
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                Padding="0,0,6,0">
                <StackPanel Spacing="14">

                    <!-- Diff Preview -->
                    <Border Background="{DynamicResource BgElevatedBrush}"
                        CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding L[Playlist_SyncDifferences]}"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}" />

                            <!-- Название diff -->
                            <Grid ColumnDefinitions="Auto, *, *"
                                IsVisible="{Binding HasNameDiff}">
                                <PathIcon Grid.Column="0"
                                    Data="{StaticResource Icon.FormatTitle}"
                                    Width="16" Height="16" Margin="0,0,8,0"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding L[Playlist_SyncField_Local]}"
                                        FontSize="10"
                                        Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Preview.LocalName}"
                                        FontSize="12" FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="{Binding L[Playlist_SyncField_Cloud]}"
                                        FontSize="10"
                                        Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Preview.CloudName}"
                                        FontSize="12" FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- Описание diff -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasDescDiff}">
                                <PathIcon Data="{StaticResource Icon.TextBoxOutline}"
                                    Width="16" Height="16"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{Binding L[Playlist_SyncDescChanged]}"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Треки diff: иконка -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasTrackDiff}">
                                <PathIcon Data="{StaticResource Icon.MusicNote}"
                                    Width="16" Height="16"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TrackDiffSummary}"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Нет различий -->
                            <TextBlock Text="{Binding L[Playlist_SyncNoChanges]}"
                                FontSize="12"
                                Foreground="{DynamicResource TextMutedBrush}"
                                IsVisible="{Binding !Preview.HasAnyDifference}" />
                        </StackPanel>
                    </Border>

                    <!-- Thumbnail Diff -->
                    <Border Background="{DynamicResource BgElevatedBrush}"
                        CornerRadius="8" Padding="14,12"
                        IsVisible="{Binding HasThumbnailSection}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding L[Playlist_SyncField_Thumbnail]}"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}" />

                            <!-- Две обложки рядом когда diff есть -->
                            <Grid ColumnDefinitions="*, Auto, *"
                                IsVisible="{Binding ThumbnailDiffers}">

                                <!-- Локальная обложка -->
                                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding L[Playlist_SyncField_Local]}"
                                        FontSize="10"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        HorizontalAlignment="Center" />
                                    <Border Width="100" Height="100"
                                        CornerRadius="6" ClipToBounds="True"
                                        Background="{DynamicResource BgSkeletonBrush}">
                                        <Panel>
                                            <PathIcon Data="{StaticResource Icon.ImageOutline}"
                                                Width="32" Height="32"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding LocalThumbnailPreviewUrl,
                                                    Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                            <Image
                                                controls:SmartImage.Source="{Binding LocalThumbnailPreviewUrl}"
                                                controls:SmartImage.Quality="Medium"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding LocalThumbnailPreviewUrl,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Panel>
                                    </Border>
                                </StackPanel>

                                <!-- Стрелка между обложками -->
                                <PathIcon Grid.Column="1"
                                    Data="{StaticResource Icon.ArrowRight}"
                                    Width="20" Height="20"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    VerticalAlignment="Center"
                                    Margin="12,16,12,0" />

                                <!-- Облачная обложка -->
                                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding L[Playlist_SyncField_Cloud]}"
                                        FontSize="10"
                                        Foreground="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" />
                                    <Border Width="100" Height="100"
                                        CornerRadius="6" ClipToBounds="True"
                                        Background="{DynamicResource BgSkeletonBrush}">
                                        <Panel>
                                            <PathIcon Data="{StaticResource Icon.ImageOutline}"
                                                Width="32" Height="32"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CloudThumbnailPreviewUrl,
                                                    Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                            <Image
                                                controls:SmartImage.Source="{Binding CloudThumbnailPreviewUrl}"
                                                controls:SmartImage.Quality="Medium"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding CloudThumbnailPreviewUrl,
                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </Panel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Одна обложка когда diff нет -->
                            <StackPanel HorizontalAlignment="Center" Spacing="6"
                                IsVisible="{Binding !ThumbnailDiffers}">
                                <Border Width="100" Height="100"
                                    CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource BgSkeletonBrush}">
                                    <Image
                                        controls:SmartImage.Source="{Binding CloudThumbnailPreviewUrl}"
                                        controls:SmartImage.Quality="Medium"
                                        Stretch="UniformToFill" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Strategy selector -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[Playlist_SyncStrategy]}"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox SelectedIndex="{Binding SelectedStrategyIndex}"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.SwapHorizontal}" Width="16"
                                        Height="16" />
                                    <TextBlock Text="{Binding L[Playlist_SyncStrategy_Merge]}" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.CloudDownload}" Width="16"
                                        Height="16" />
                                    <TextBlock
                                        Text="{Binding L[Playlist_SyncStrategy_ReplaceLocal]}" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Icon.CloudUpload}" Width="16"
                                        Height="16" />
                                    <TextBlock
                                        Text="{Binding L[Playlist_SyncStrategy_ReplaceCloud]}" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="{Binding StrategyDescription}"
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            TextWrapping="Wrap"
                            Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Field checkboxes -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[Playlist_SyncFields]}"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Border Background="{DynamicResource BgElevatedBrush}"
                            CornerRadius="8" Padding="14,10">
                            <StackPanel Spacing="8">
                                <!-- Field checkboxes -->
                                <CheckBox IsChecked="{Binding SyncName}"
                                    IsEnabled="{Binding HasNameDiff}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.FormatTitle}"
                                            Width="14" Height="14" />
                                        <TextBlock Text="{Binding L[Playlist_SyncField_Name]}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding SyncDescription}"
                                    IsEnabled="{Binding HasDescDiff}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.TextBoxOutline}"
                                            Width="14" Height="14" />
                                        <TextBlock
                                            Text="{Binding L[Playlist_SyncField_Description]}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding SyncThumbnail}"
                                    IsEnabled="{Binding CanSyncThumbnail}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.ImageOutline}"
                                            Width="14" Height="14" />
                                        <TextBlock Text="{Binding L[Playlist_SyncField_Thumbnail]}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding SyncTracks}"
                                    IsEnabled="{Binding HasTrackDiff}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.MusicNote}" Width="14"
                                            Height="14" />
                                        <TextBlock Text="{Binding L[Playlist_SyncField_Tracks]}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="12"
                Margin="0,16,0,0">
                <Button Content="{Binding L[Common_Cancel]}"
                    Command="{Binding CancelCommand}"
                    Background="Transparent" />
                <!-- Кнопка Sync -->
                <Button Command="{Binding SyncCommand}" Classes="accent accent-base">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Sync}" Width="16" Height="16" />
                        <TextBlock Text="{Binding L[Playlist_SyncButton]}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>