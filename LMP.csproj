<Project Sdk="Microsoft.NET.Sdk">

    <!-- Package versions are specified centrally in Directory.Packages.props -->

    <!--   MAIN SETTINGS            -->
    <PropertyGroup Label="Core Settings">
        <!-- In Release — no console window; in Debug — with console for logs -->
        <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
        <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>

        <!--
          net11.0 — preview (GA expected November 2026).
          Conscious choice: Runtime Async without EnablePreviewFeatures, JIT improvements.
        -->
        <TargetFramework>net11.0</TargetFramework>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

        <RootNamespace>LMP</RootNamespace>
        <AssemblyName>LMP</AssemblyName>

        <!-- Exclude subproject folders from the root project at the .NET file system level -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;SharpJaad.AAC/**;Tools/**</DefaultItemExcludes>

        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/app.ico</ApplicationIcon>

        <!-- Compiled bindings by default: faster + compile-time type checking -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!--   MEMORY / JIT OPTIMIZATION -->
    <PropertyGroup Label="Runtime Tuning">
        <!--
          Workstation GC: lower RAM consumption, better UI responsiveness.
          Server GC is intended for server scenarios — not needed here.
        -->
        <ServerGarbageCollection>false</ServerGarbageCollection>

        <!-- Background (Concurrent) GC: garbage collection does not block the UI thread -->
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

        <!--
          Return memory to the OS after a GC cycle.
          Correct choice for media apps with large image/audio caches.
        -->
        <RetainVMGarbageCollection>false</RetainVMGarbageCollection>

        <!--
          Tiered Compilation + Dynamic PGO:
          - Fast startup (QuickJit for "cold" code)
          - On-the-fly auto-optimization of hot paths (TieredPGO)
        -->
        <TieredCompilation>true</TieredCompilation>
        <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <!--   DEBUG CONFIGURATION      -->
    <PropertyGroup Label="Debug" Condition="'$(Configuration)' == 'Debug'">
        <!-- Embedded PDBs + sources: step-by-step debugging without external files -->
        <DebugType>embedded</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <!--   RELEASE & AOT CONFIGURATION    -->
    <PropertyGroup Label="Release" Condition="'$(Configuration)' == 'Release'">
        <DebugType Condition="'$(EmitAotPdb)' != 'true'">none</DebugType>
        <DebugType Condition="'$(EmitAotPdb)' == 'true'">pdbonly</DebugType>
        <DebugSymbols Condition="'$(EmitAotPdb)' == 'true'">true</DebugSymbols>
        <StripSymbols Condition="'$(EmitAotPdb)' == 'true'">false</StripSymbols>
        <Optimize>true</Optimize>

        <DefaultItemExcludes>$(DefaultItemExcludes);UI/Features/Debug/**;Tests/**</DefaultItemExcludes>

        <!-- Native AOT and full trimming of compiled machine code -->
        <PublishAot>true</PublishAot>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <TrimmerRootDescriptor>trimming.xml</TrimmerRootDescriptor>

        <!-- Strictly disable reflection fallback for System.Text.Json -->
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

        <!-- ILC compiler optimizations for Native AOT -->
        <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies Condition="'$(EmitAotPdb)' != 'true'">true</IlcFoldIdenticalMethodBodies>
    </PropertyGroup>

    <!-- Runtime configuration for Native AOT (replaces runtimeconfig.template.json) -->
    <ItemGroup Label="Runtime Host Configuration">
        <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="8"/>
    </ItemGroup>

    <ItemGroup Label="File Includes/Excludes">
        <AvaloniaResource Include="Assets/**"/>
        <Content Include="Assets/app.ico"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <Content Include="Native/quickjs_bridge_debug.dll">
            <Link>quickjs_bridge.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Content Include="Native/quickjs_bridge_release.dll">
            <Link>quickjs_bridge.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>

    <ItemGroup Label="Avalonia Core">
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Concentus.Native"/>
    </ItemGroup>

    <ItemGroup Label="Avalonia Community">
        <PackageReference Include="Xaml.Behaviors.Avalonia"/>
    </ItemGroup>

    <ItemGroup Label="MVVM">
        <PackageReference Include="CommunityToolkit.Mvvm"/>
    </ItemGroup>

    <ItemGroup Label="UI Utilities">
        <PackageReference Include="AsyncImageLoader.Avalonia"/>
    </ItemGroup>

    <ItemGroup Label="Linux Interop">
        <PackageReference Include="Tmds.DBus.Protocol"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Core/LMP.Core.csproj"/>
    </ItemGroup>

    <!-- Test registry generator: analyzer only, not included in the output assembly. Does not build Release tests -->
    <ItemGroup Label="Test Registry Generator" Condition="'$(Configuration)' != 'Release'">
        <ProjectReference Include="Tools/LMP.Tests.Generator/LMP.Tests.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
