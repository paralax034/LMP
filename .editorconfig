# --- Global Engine Configuration ---
root = true

# --- Global Code Formatting Rules ---
[*]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# --- Line Ending Overrides ---
# Shell scripts and Git hooks must always use LF line endings for cross-platform compatibility.
[*.sh]
end_of_line = lf

[Tools/githooks/*]
end_of_line = lf

# Localization files are indented with 2 spaces to reduce file size and improve readability.
[Assets/Localization/*.json]
indent_size = 2


# --- C# Formatting Rules ---
[*.cs]
# Braces placement (Allman style - new line for all elements)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

# Spacing preferences
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_binary_operators = before_and_after

# --- Code Style: Usings, Simplification, Pattern Matching & Modern C# ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:warning

csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_prefer_tuple_swap = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_prefer_static_local_function = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion
csharp_style_prefer_readonly_struct_member = true:suggestion

dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# --- Diagnostics & Analyzer Rules ---
# Unused code & dead symbols (build errors; IDE0005 replaces CS8019 with generated-code filtering)
dotnet_diagnostic.CS0168.severity = error
dotnet_diagnostic.CS0169.severity = error
dotnet_diagnostic.CS0219.severity = error
dotnet_diagnostic.CS0414.severity = error
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.IDE0059.severity = error
dotnet_diagnostic.IDE0060.severity = error

# High-signal performance, AOT, Lock, Span & ValueTask correctness (build errors)
dotnet_diagnostic.CA1825.severity = error
dotnet_diagnostic.CA1826.severity = error
dotnet_diagnostic.CA1827.severity = error
dotnet_diagnostic.CA1828.severity = error
dotnet_diagnostic.CA1829.severity = error
dotnet_diagnostic.CA1836.severity = error
dotnet_diagnostic.CA1851.severity = error
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.CA2013.severity = error
dotnet_diagnostic.CA2014.severity = error
dotnet_diagnostic.CA2265.severity = error
dotnet_diagnostic.CS9216.severity = error
dotnet_diagnostic.SYSLIB1045.severity = error

# Performance & Native AOT recommendations (warnings; treated as errors via TreatWarningsAsErrors)
dotnet_diagnostic.CA1830.severity = warning
dotnet_diagnostic.CA1834.severity = warning
dotnet_diagnostic.CA1835.severity = warning
dotnet_diagnostic.CA1837.severity = warning
dotnet_diagnostic.CA1838.severity = warning
dotnet_diagnostic.CA1845.severity = warning
dotnet_diagnostic.CA1846.severity = warning
dotnet_diagnostic.CA1847.severity = warning
