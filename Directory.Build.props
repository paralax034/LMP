<Project>
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- Чтобы IDE-диагностики тоже попадали в сборку (важно для CI) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Опционально, но полезно чтобы реально “давило” -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

   <!-- Отключаем генерацию и поиск сателлитных сборок ресурсов: локализация работает через JSON -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- Низкоуровневый покадровый осциллограф склейки аудио включается ТОЛЬКО при явной сборке с -p:AudioDiag=true -->
    <DefineConstants Condition="'$(AudioDiag)' == 'true'">$(DefineConstants);AUDIO_SPLICE_AUDIT</DefineConstants>
  </PropertyGroup>
</Project>