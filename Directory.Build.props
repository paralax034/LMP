<Project>
  <PropertyGroup>
    <!-- Явная конфигурация по умолчанию: свойства ниже (путь lock-файла) вычисляются раньше, чем SDK подставит Debug сам -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- Чтобы IDE-диагностики тоже попадали в сборку (важно для CI) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Любое предупреждение компилятора и анализаторов прерывает сборку -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Исключение — уведомления NuGet Audit об уязвимостях (NU1901–NU1904): они остаются видимыми предупреждениями
      и не блокируют сборку, пока исправленная версия пакета не опубликована.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Раздельные lock-файлы под каждую конфигурацию во всех проектах (устраняет взаимную перезапись Debug/Release) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(Configuration).lock.json</NuGetLockFilePath>

    <!-- Отключаем генерацию и поиск сателлитных сборок ресурсов: локализация работает через JSON -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- Низкоуровневый покадровый осциллограф склейки аудио включается ТОЛЬКО при явной сборке с -p:AudioDiag=true -->
    <DefineConstants Condition="'$(AudioDiag)' == 'true'">$(DefineConstants);AUDIO_SPLICE_AUDIT</DefineConstants>
  </PropertyGroup>
</Project>