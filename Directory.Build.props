<Project>
  <PropertyGroup>
    <!-- Explicit default configuration: properties below (lock file path) are evaluated before the SDK assigns Debug by default -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- Ensures IDE diagnostics are also included in the build (important for CI) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Any compiler or analyzer warning breaks the build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Exception — NuGet Audit vulnerability notifications (NU1901–NU1904): they remain visible as warnings
      and do not block the build until a patched package version is published.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Separate lock files per configuration across all projects (prevents Debug/Release cross-overwrites) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(Configuration).lock.json</NuGetLockFilePath>

    <!-- Disable generation and resolution of resource satellite assemblies: localization uses JSON -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!--
      CRITICAL for .NET 11 RC2/RC3+ and Avalonia (AvaloniaUI/Avalonia#22465):
      In .NET 11 SDK with PublishAot=true, UseOptimizedPublish=true is enabled by default, which triggers
      PrepareResources before ResolveReferences, causing AddAvaloniaResources to skip all .axaml and Assets.
    -->
    <UseOptimizedPublish>false</UseOptimizedPublish>

    <!-- Strip unused EventSource/Activity telemetry and Hot Reload metadata from Release/AOT -->
    <EventSourceSupport Condition="'$(Configuration)' == 'Release'">false</EventSourceSupport>
    <HttpActivityPropagationSupport Condition="'$(Configuration)' == 'Release'">false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport Condition="'$(Configuration)' == 'Release'">false</MetadataUpdaterSupport>

    <!-- Low-level frame-by-frame audio stitching oscilloscope is enabled ONLY during explicit builds with -p:AudioDiag=true -->
    <DefineConstants Condition="'$(AudioDiag)' == 'true'">$(DefineConstants);AUDIO_SPLICE_AUDIT</DefineConstants>
  </PropertyGroup>
</Project>