<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LMP"
             x:Class="LMP.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LMP/UI/Converters/AppConverters.axaml" />
                <ResourceInclude Source="avares://LMP/UI/Theme/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://AsyncImageLoader.Avalonia/AdvancedImage.axaml" />

        <!-- 1. ToolTip первым -->
        <StyleInclude Source="avares://LMP/UI/Theme/ToolTipTheme.axaml" />
        <!-- 2. Theme.axaml: Typography, Buttons, Controls, AppComponents, PlayerBarStyles -->
        <StyleInclude Source="avares://LMP/UI/Theme/Theme.axaml" />
    </Application.Styles>

</Application>
