<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;IsAotCompatible;RuntimeIdentifier;SelfContained">

    <!--
      Test registry generator: transforms methods marked with [TestMethod] into a descriptor
      table with pre-built invocation delegates at build time. Replaces reflection-based discovery in TestDiscovery.
      Roslyn analyzers must be built targeting netstandard2.0.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>false</IsPackable>

        <!--
          The analyzer executes inside the compiler and is never published: AOT properties passed
          via the command line for the application (dotnet publish -p:PublishAot=true) are explicitly disabled here.
          Without this, netstandard2.0 fails with NETSDK1207.
        -->
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <IsAotCompatible>false</IsAotCompatible>
        <RuntimeIdentifier></RuntimeIdentifier>
        <SelfContained>false</SelfContained>

        <!-- RS2008: analyzer release tracking is not required for an internal generator -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>

        <!-- The Roslyn version is pinned here: the generator does not participate in the main application package graph -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all"/>
    </ItemGroup>

</Project>