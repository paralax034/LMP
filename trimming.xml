<!--
  Trimmer Root Descriptor for Release (Native AOT, TrimMode=full).
  Preserves only assemblies that trimming cannot fully analyze statically:
  Opus audio codec native interop and SQLite.
  Intentionally omitted (trimming-compatible without a descriptor):
  - System.Text.Json: AppJsonContext uses source generation, reflection fallback is disabled in Release;
  - MemoryPack: serializers are generated at compile time;
  - LMP.Core models: DB operates via ADO.NET without reflection mapping;
  - Microsoft.Extensions.DependencyInjection: registrations are annotated with DynamicallyAccessedMembers.
-->
<linker>

  <!-- Opus: Concentus managed decoder and libopus native wrapper -->
  <assembly fullname="Concentus" preserve="all" />
  <assembly fullname="Concentus.Native" preserve="all" />

  <!--
    SQLite: ADO.NET provider and SQLitePCLRaw native bridge (P/Invoke and callbacks from native code).
    The Microsoft.Data.Sqlite.Core package provides the Microsoft.Data.Sqlite assembly; no assembly named after the package exists.
  -->
  <assembly fullname="Microsoft.Data.Sqlite" preserve="all" />
  <assembly fullname="SQLitePCLRaw.core" preserve="all" />
  <assembly fullname="SQLitePCLRaw.provider.e_sqlite3" preserve="all" />

</linker>