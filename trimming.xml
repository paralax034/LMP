<!--
  Trimmer Root Descriptor для Release (Native AOT, TrimMode=full).
  Сохраняются только сборки, которые тримминг не может полностью проанализировать статически:
  нативный interop аудиокодека Opus и SQLite.
  Намеренно не перечислены (совместимы с триммингом без дескриптора):
  - System.Text.Json: AppJsonContext использует source generation, рефлексивный fallback в Release отключен;
  - MemoryPack: сериализаторы генерируются на этапе компиляции;
  - модели LMP.Core: БД работает через ADO.NET без рефлексивного маппинга;
  - Microsoft.Extensions.DependencyInjection: регистрации аннотированы DynamicallyAccessedMembers.
-->
<linker>

  <!-- Opus: управляемый декодер Concentus и нативная обертка libopus -->
  <assembly fullname="Concentus" preserve="all" />
  <assembly fullname="Concentus.Native" preserve="all" />

  <!--
    SQLite: ADO.NET-провайдер и нативный мост SQLitePCLRaw (P/Invoke и обратные вызовы из нативного кода).
    Пакет Microsoft.Data.Sqlite.Core поставляет сборку Microsoft.Data.Sqlite; сборки с именем пакета не существует.
  -->
  <assembly fullname="Microsoft.Data.Sqlite" preserve="all" />
  <assembly fullname="SQLitePCLRaw.core" preserve="all" />
  <assembly fullname="SQLitePCLRaw.provider.e_sqlite3" preserve="all" />

</linker>