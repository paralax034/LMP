<!--
  Trimmer Root Descriptor.
  Защищает типы, используемые через EF Core, нативный P/Invoke,
  SQLite-провайдер и скомпилированные контексты JSON.
-->
<linker>

  <!-- ADO NET -->
  <assembly fullname="LMP.Core">
    <!-- JSON Source Generation контекст -->
    <type fullname="LMP.Core.Models.AppJsonContext" preserve="all" />

    <!-- Модели, используемые в настройках и сохранении состояния -->
    <type fullname="LMP.Core.Models.AppSettings" preserve="all" />
    <type fullname="LMP.Core.Models.BootstrapSettings" preserve="all" />
    <type fullname="LMP.Core.Models.ThemeSettings" preserve="all" />
    <type fullname="LMP.Core.Models.StreamingConfig" preserve="all" />

    <!-- Доменные модели сущностей данных -->
    <type fullname="LMP.Core.Models.TrackInfo" preserve="all" />
    <type fullname="LMP.Core.Models.Playlist" preserve="all" />
  </assembly>

  <!-- Concentus -->
  <assembly fullname="Concentus" preserve="all" />
  <assembly fullname="Concentus.Native" preserve="all" />

  <!-- SQLite native interop и низкоуровневый драйвер C-библиотеки -->
  <assembly fullname="Microsoft.Data.Sqlite" preserve="all" />
  <assembly fullname="Microsoft.Data.Sqlite.Core" preserve="all" />
  <assembly fullname="SQLitePCLRaw.core" preserve="all" />
  <assembly fullname="SQLitePCLRaw.provider.e_sqlite3" preserve="all" />

  <!-- Базовые сборки Avalonia UI для отрисовки и разметки XAML -->

  <!-- Microsoft Dependency Injection -->
  <assembly fullname="Microsoft.Extensions.DependencyInjection" preserve="all" />

</linker>