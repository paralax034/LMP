{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "⚡ Debug (Fast Startup)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: debug",
            "program": "${workspaceFolder}/bin/Debug/net11.0/LMP.dll",
            "args": ["-f"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "justMyCode": false,
            "suppressJITOptimizations": true,
            "logging": {
                "moduleLoad": false,
                "exceptions": false,
                "programOutput": true
            },
            "symbolOptions": {
                "searchMicrosoftSymbolServer": false,
                "searchNuGetOrgSymbolServer": false,
                "searchPaths": ["${workspaceFolder}/bin/Debug/net11.0"]
            }
        },
