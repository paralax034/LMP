{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "C:\\Windows\\System32\\cmd.exe",
            "args": ["/d", "/c", "chcp 65001 >nul &&"]
        }
    },
    "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
    },
    "tasks": [
        {
            "label": "build: debug",
            "type": "shell",
            "command": "python build.py debug nopause",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": { "panel": "shared" }
        },
        {
            "label": "build: release",
            "type": "shell",
            "command": "python build.py release nopause",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": { "panel": "shared" }
        },
        {
            "label": "build: clean",
            "type": "shell",
            "command": "python build.py clean nopause",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build: restore",
            "type": "shell",
            "command": "python build.py restore nopause",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish: release (AOT)",
            "type": "shell",
            "command": "python build.py publish nopause",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish: dev (GitHub)",
            "type": "shell",
            "command": "python Tools\\publish_dev.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: asm-audit",
            "type": "shell",
            "command": "python Tools\\audit_asm.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: dead-code",
            "type": "shell",
            "command": "python Tools\\find_dead_code.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: dead-styles",
            "type": "shell",
            "command": "python Tools\\find_dead_styles.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: audit-l10n",
            "type": "shell",
            "command": "python Tools\\audit_l10n.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: sort-l10n",
            "type": "shell",
            "command": "python Tools\\sort_l10n.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: fix-l10n",
            "type": "shell",
            "command": "python Tools\\audit_l10n.py --fix && python Tools\\sort_l10n.py",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "tool: update-dependencies",
            "type": "shell",
            "command": "python Tools\\update_dependencies.py",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
