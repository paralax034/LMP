{
    "version": "2.0.0",
    "options": {"cwd": "${workspaceFolder}", "shell": {"executable": "C:\\Windows\\System32\\cmd.exe", "args": ["/d", "/c", "chcp 65001 >nul &&"]}},
    "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
    "tasks": [
        {"label": "build: debug", "type": "shell", "command": "python build.py debug nopause", "group": {"kind": "build", "isDefault": true}, "problemMatcher": "$msCompile", "presentation": {"panel": "shared"}},
        {"label": "build: optimized", "type": "shell", "command": "python build.py optimized nopause", "group": "build", "problemMatcher": "$msCompile", "presentation": {"panel": "shared"}},
        {"label": "build: release", "type": "shell", "command": "python build.py release nopause", "group": "build", "problemMatcher": "$msCompile", "presentation": {"panel": "shared"}},
        {"label": "build: restore", "type": "shell", "command": "python build.py restore nopause", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "build: clean", "type": "shell", "command": "python build.py clean nopause", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "run: fast", "type": "shell", "command": "python build.py fast nopause", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "test: unit", "type": "shell", "command": "python build.py test --category=Unit nopause", "group": "test", "problemMatcher": "$msCompile", "presentation": {"focus": true}},
        {"label": "test: all", "type": "shell", "command": "python build.py test nopause", "group": "test", "problemMatcher": "$msCompile", "presentation": {"focus": true}},
        {"label": "test: custom filter", "type": "shell", "command": "python build.py test ${input:testFilter} nopause", "group": "test", "problemMatcher": "$msCompile", "presentation": {"focus": true}},
        {"label": "test: list all discovered", "type": "shell", "command": "python build.py test list nobuild nopause", "group": "test", "problemMatcher": [], "presentation": {"focus": true}},
        {"label": "test: ui (DebugWindow)", "type": "shell", "command": "python build.py test-ui nopause", "group": "test", "problemMatcher": "$msCompile"},
        {"label": "test: ui + autorun Unit", "type": "shell", "command": "python build.py test-ui Unit run nopause", "group": "test", "problemMatcher": "$msCompile"},
        {"label": "aot: publish debug", "type": "shell", "command": "python build.py aot-debug nopause", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "aot: test unit", "type": "shell", "command": "python build.py aot-test --category=Unit nopause", "group": "test", "problemMatcher": "$msCompile", "presentation": {"focus": true}},
        {"label": "aot: test benchmark (no rebuild)", "type": "shell", "command": "python build.py aot-test --category=Benchmark nobuild nopause", "group": "test", "problemMatcher": "$msCompile", "presentation": {"focus": true}},
        {"label": "analyze: l10n", "type": "shell", "command": "python Tools\\audit_l10n.py", "group": "build", "problemMatcher": []},
        {"label": "analyze: dead-styles", "type": "shell", "command": "python Tools\\find_dead_styles.py", "group": "build", "problemMatcher": []},
        {"label": "analyze: dead-code (full)", "type": "shell", "command": "python Tools\\find_dead_code.py", "group": "build", "problemMatcher": []},
        {"label": "analyze: dead-code (fast)", "type": "shell", "command": "python Tools\\find_dead_code.py --skip-build", "group": "build", "problemMatcher": []},
        {"label": "analyze: dependencies", "type": "shell", "command": "python Tools\\update_dependencies.py --dry-run", "group": "build", "problemMatcher": []},
        {"label": "tool: fix-l10n", "type": "shell", "command": "python Tools\\audit_l10n.py --fix", "group": "build", "problemMatcher": []},
        {"label": "tool: sort-l10n", "type": "shell", "command": "python Tools\\sort_l10n.py", "group": "build", "problemMatcher": []},
        {"label": "tool: update-dependencies", "type": "shell", "command": "python Tools\\update_dependencies.py", "group": "build", "problemMatcher": []},
        {"label": "tool: format-code", "type": "shell", "command": "dotnet format LMP.sln", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "publish: release", "type": "shell", "command": "python build.py publish nopause", "group": "build", "problemMatcher": "$msCompile"},
        {"label": "publish: dev (full)", "type": "shell", "command": "python Tools\\publish_dev.py", "group": "build", "problemMatcher": [], "presentation": {"focus": true}},
        {"label": "publish: dev (skip tests)", "type": "shell", "command": "python Tools\\publish_dev.py --skip-tests", "group": "build", "problemMatcher": [], "presentation": {"focus": true}},
        {"label": "publish: dev (release only)", "type": "shell", "command": "python Tools\\publish_dev.py --release-only", "group": "build", "problemMatcher": [], "presentation": {"focus": true}},
        {"label": "publish: dev (skip build)", "type": "shell", "command": "python Tools\\publish_dev.py --skip-build", "group": "build", "problemMatcher": [], "presentation": {"focus": true}}
    ],
    "inputs": [
        {"id": "testFilter", "type": "promptString", "description": "Group (Storage, Audio, Cipher...), Category (Unit, Integration...), or Test/Class name filter:", "default": "Storage"}
    ]
}