<Project>
  <!-- Target for assembling Git metadata. 
       Executes for both Debug and Release, but only during a REAL build (not background build in an editor) -->
  <Target Name="SetGitVersionInfo"
    BeforeTargets="PrepareForBuild;GetAssemblyVersion;GenerateAssemblyInfo"
    Condition="Exists('$(MSBuildThisFileDirectory).git') And '$(DesignTimeBuild)' != 'true'">

    <!-- Get the commit count (build number) -->
    <Exec Command="git rev-list --count HEAD"
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      ConsoleToMSBuild="true"
      StandardOutputImportance="low"
      IgnoreExitCode="true"
      ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>

    <!-- Get the short SHA hash of the last commit -->
    <Exec Command="git rev-parse --short=7 HEAD"
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      ConsoleToMSBuild="true"
      StandardOutputImportance="low"
      IgnoreExitCode="true"
      ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShortHash" />
    </Exec>

    <!-- Fallback values handling in case Git fails -->
    <PropertyGroup Condition="'$(GitExitCode)' != '0' OR '$(GitCommitCount)' == ''">
      <GitCommitCount>0</GitCommitCount>
      <GitShortHash>local</GitShortHash>
    </PropertyGroup>

    <!-- Whitespace trimming -->
    <PropertyGroup>
      <GitCommitCount>$(GitCommitCount.Trim())</GitCommitCount>
      <GitShortHash>$(GitShortHash.Trim())</GitShortHash>
    </PropertyGroup>

    <!-- Writing computed versions to build properties -->
    <PropertyGroup>
      <Version>$(VersionMajor).$(VersionMinor).$(GitCommitCount)</Version>
      <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount).0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount).0</FileVersion>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount)+$(GitShortHash)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="High" Text="══════════════════════════════════════" />
    <Message Importance="High"
      Text="[Git] Build #$(GitCommitCount) ($(GitShortHash)) успешно внедрен в сборку" />
    <Message Importance="High" Text="══════════════════════════════════════" />
  </Target>

  <!-- Fallback target: triggered if there is no Git repository or a background (Design-Time) build is running in the editor. -->
  <Target Name="SetFallbackVersion"
    BeforeTargets="PrepareForBuild;GetAssemblyVersion;GenerateAssemblyInfo"
    Condition="!Exists('$(MSBuildThisFileDirectory).git') Or '$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <Version>$(VersionMajor).$(VersionMinor).0</Version>
      <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).0.0</FileVersion>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).0+local</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>