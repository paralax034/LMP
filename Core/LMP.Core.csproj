<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net11.0 — preview (GA ожидается ноябрь 2026).
      Осознанный выбор: синхронизировано с корневым проектом.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LMP.Core</AssemblyName>
    <RootNamespace>LMP.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Отключаем рефлексию JSON в Release для Native AOT -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Подавляем предупреждения анализа тримминга/AOT сторонних зависимостей синхронно с корневым проектом -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL3051;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="UI Core Dependencies">
    <PackageReference Include="Avalonia" />
    <PackageReference Include="AsyncImageLoader.Avalonia" />
    <!-- SkiaSharp приходит транзитивно через Avalonia.Skia: версия Skia всегда совпадает с ожидаемой Avalonia -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup Label="Serialization">
    <PackageReference Include="MemoryPack" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Label="Audio">
    <PackageReference Include="Concentus" />
  </ItemGroup>

  <ItemGroup Label="Scripting">
    <PackageReference Include="Acornima" />
  </ItemGroup>

  <ItemGroup Label="Data &amp; Security">
    <!--
      ADO.NET-провайдер SQLite для библиотеки и чтения баз браузеров.
      Нативный мост SQLitePCLRaw (bundle_e_sqlite3) приходит транзитивно в версии, ожидаемой провайдером.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpJaad.AAC\SharpJaad.AAC.csproj" />
  </ItemGroup>

</Project>