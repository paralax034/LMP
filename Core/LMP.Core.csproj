<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net11.0 — preview (GA expected November 2026).
      Deliberate choice: synchronized with the root project.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LMP.Core</AssemblyName>
    <RootNamespace>LMP.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Disable JSON reflection in Release for Native AOT -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Suppress trimming/AOT analyzer warnings for third-party dependencies synchronously with the root project -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL3051;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="UI Core Dependencies">
    <PackageReference Include="Avalonia" />
    <PackageReference Include="AsyncImageLoader.Avalonia" />
    <!-- SkiaSharp comes transitively via Avalonia.Skia: the Skia version always matches the version expected by Avalonia -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup Label="Serialization">
    <PackageReference Include="MemoryPack" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Label="Audio">
    <PackageReference Include="Concentus" />
  </ItemGroup>

  <ItemGroup Label="Scripting">
    <PackageReference Include="Acornima" />
  </ItemGroup>

  <ItemGroup Label="Data &amp; Security">
    <!--
      SQLite ADO.NET provider for the library and reading browser databases.
      The native SQLitePCLRaw bridge (bundle_e_sqlite3) comes transitively in the version expected by the provider.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpJaad.AAC\SharpJaad.AAC.csproj" />
  </ItemGroup>

</Project>