<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net11.0 — preview (GA ожидается ноябрь 2026).
      Осознанный выбор: синхронизировано с корневым проектом.
    -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LMP.Core</AssemblyName>
    <RootNamespace>LMP.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <!-- Entity Framework Core: 10.0.11 (патчи безопасности/багфиксы) -->
    <MsExtVersion>10.0.11</MsExtVersion>
    <CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AsyncImageLoaderVersion>3.8.0</AsyncImageLoaderVersion>
    <SkiaSharpVersion>4.151.1</SkiaSharpVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Отключаем рефлексию JSON в Release для Native AOT -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Подавляем внутренние некритичные предупреждения ILC для EF Core -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL3051;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="UI Core Dependencies">
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="$(AsyncImageLoaderVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup Label="Serialization">
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>

  <!-- SQLite Native Provider -->
  <ItemGroup Label="Entity Framework">
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MsExtVersion)" />
  </ItemGroup>

  <ItemGroup Label="Audio">
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup Label="Scripting">
    <PackageReference Include="Acornima" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup Label="Diagnostics">
    <!-- Wildcard: подтягивает последний патч 0.2.x автоматически -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.*" />
  </ItemGroup>

  <ItemGroup Label="Data &amp; Security">
    <!-- Синхронизировано до $(EfCoreVersion) для работы с базами SQLite браузеров -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MsExtVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpJaad.AAC\SharpJaad.AAC.csproj" />
  </ItemGroup>

</Project>